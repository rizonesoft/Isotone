<Project>
  <!--
    Runs after MinVer computed the version. MinVer sets FileVersion to
    Major.Minor.Patch.0; replace the fourth part with the CI run number so every
    CI build carries a unique, monotonic Win32 file version. Values above 65535
    wrap (Win32 version parts are 16-bit).
  -->
  <Target Name="PhotonFileVersion" AfterTargets="MinVer" Condition="'$(MinVerMajor)' != ''">
    <PropertyGroup>
      <_PhotonBuildPart>$([MSBuild]::Modulo($(PhotonBuildNumber), 65536))</_PhotonBuildPart>
      <FileVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).$(_PhotonBuildPart)</FileVersion>
    </PropertyGroup>
  </Target>
</Project>
