# Photon Graphics Suite: line endings and binary handling.
* text=auto

# LF: scripts, docs, config read by POSIX tools, and git hooks
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
tools/githooks/** text eol=lf
todo/.warning-baseline text eol=lf
todo/.design-baseline text eol=lf
docs/reviews/** text eol=lf

# CRLF: Windows-native sources and project files
*.cs text eol=crlf diff=csharp
*.xaml text eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.slnf text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.iss text eol=crlf
*.resx text eol=crlf
*.runsettings text eol=crlf
*.manifest text eol=crlf
*.xshd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.icns binary
*.webp binary
*.tif binary
*.tiff binary
*.psd binary
*.cur binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.7z binary
*.pdf binary
*.dll binary
*.exe binary
*.snk binary
*.pfx binary
