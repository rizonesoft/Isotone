# Isotone Graphics Suite: line endings and binary handling.
* text=auto

# LF: native C/C++ and CMake sources, shaders, scripts, docs, config, and git hooks
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.c++ text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.h++ text eol=lf
*.ixx text eol=lf
*.inl text eol=lf
*.ipp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.hlsl text eol=lf
*.hlsli text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
tools/githooks/** text eol=lf
todo/.warning-baseline text eol=lf
todo/.design-baseline text eol=lf
docs/reviews/** text eol=lf

# CRLF: Windows installer scripts and application manifests
*.iss text eol=crlf
*.manifest text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.icns binary
*.webp binary
*.tif binary
*.tiff binary
*.psd binary
*.cur binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.7z binary
*.pdf binary
*.dll binary
*.exe binary
*.pfx binary

# A source archive (git archive) carries its commit in this file, which native/cmake/WriteBuildId.cmake reads when
# there is no .git (D00 T05 §3).
native/BUILD_ID.txt export-subst
