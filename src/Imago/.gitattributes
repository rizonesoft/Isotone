# Auto detect text files and perform LF normalization
* text=auto

# C# source files
*.cs text diff=csharp

# XAML files
*.xaml text

# Config files
*.json text
*.xml text
*.config text
*.props text
*.targets text

# Project files
*.sln text eol=crlf
*.csproj text

# Documentation
*.md text
*.txt text

# Scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.webp binary
*.psd binary
*.tiff binary
*.tif binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Archives
*.zip binary
*.7z binary
*.gz binary
*.tar binary

# Executables
*.exe binary
*.dll binary
*.pdb binary

# NuGet packages
*.nupkg binary
