<Project>
  <!-- Imago overlay: imports the root build configuration, then sets app identity. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <MinVerTagPrefix>imago-v</MinVerTagPrefix>
    <Product>Imago</Product>
    <PhotonApp>Imago</PhotonApp>
  </PropertyGroup>

  <!--
    LEGACY DEBT (imported Imago code): the root configuration applies in full
    (warnings are errors, code style enforced) except for the diagnostics below,
    which stay visible as warnings. Listed in docs/dev/build.md; retire by TODO.
      IDE0005  unnecessary using directives (12 sites)
      CS0618   obsolete API use (2 sites)
      NU1701   packages restored for .NET Framework (SkiaSharp.Views.WPF 3.x, OpenTK)
  -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0005;CS0618;NU1701</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
