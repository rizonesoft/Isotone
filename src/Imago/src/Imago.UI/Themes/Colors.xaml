<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pure Grey Base Palette -->
    <Color x:Key="Base">#1E1E1E</Color>
    <Color x:Key="Mantle">#181818</Color>
    <Color x:Key="Crust">#111111</Color>
    <Color x:Key="Surface0">#2D2D2D</Color>
    <Color x:Key="Surface1">#3D3D3D</Color>
    <Color x:Key="Surface2">#4D4D4D</Color>
    <Color x:Key="Overlay0">#6D6D6D</Color>
    <Color x:Key="Overlay1">#7D7D7D</Color>
    <Color x:Key="Overlay2">#9D9D9D</Color>
    <Color x:Key="Text">#E0E0E0</Color>
    <Color x:Key="Subtext0">#A0A0A0</Color>
    <Color x:Key="Subtext1">#B0B0B0</Color>
    
    <!-- Accent Colors (preserved) -->
    <Color x:Key="Blue">#89B4FA</Color>
    <Color x:Key="Lavender">#B4BEFE</Color>
    <Color x:Key="Sapphire">#74C7EC</Color>
    <Color x:Key="Sky">#89DCEB</Color>
    <Color x:Key="Teal">#94E2D5</Color>
    <Color x:Key="Green">#A6E3A1</Color>
    <Color x:Key="Yellow">#F9E2AF</Color>
    <Color x:Key="Peach">#FAB387</Color>
    <Color x:Key="Maroon">#EBA0AC</Color>
    <Color x:Key="Red">#F38BA8</Color>
    <Color x:Key="Mauve">#CBA6F7</Color>
    <Color x:Key="Pink">#F5C2E7</Color>
    <Color x:Key="Flamingo">#F2CDCD</Color>
    <Color x:Key="Rosewater">#F5E0DC</Color>
    
    <!-- Imago Orange Accent (Modern, Warm) -->
    <Color x:Key="AccentOrange">#FF6B35</Color>
    <Color x:Key="AccentOrangeLight">#FF8C5A</Color>
    <Color x:Key="AccentOrangeDark">#E85A2A</Color>
    
    <!-- Legacy Compatibility -->
    <Color x:Key="ImagoPrimaryColor">#FF6B35</Color>
    <Color x:Key="ImagoSecondaryColor">#89B4FA</Color>
    <Color x:Key="ImagoAccentColor">#FF6B35</Color>
    
    <!-- Canvas Colors -->
    <Color x:Key="CanvasBackgroundColor">#1E1E1E</Color>
    <Color x:Key="CanvasGridColor">#2D2D2D</Color>
    <Color x:Key="CanvasSelectionColor">#FF6B35</Color>
    
    <!-- Layer Colors -->
    <Color x:Key="LayerSelectedColor">#FF6B35</Color>
    <Color x:Key="LayerHoverColor">#3D3D3D</Color>
    <Color x:Key="LayerLockedColor">#6D6D6D</Color>
    
    <!-- Tool Colors -->
    <Color x:Key="ToolActiveColor">#FF6B35</Color>
    <Color x:Key="ToolHoverColor">#3D3D3D</Color>
    
</ResourceDictionary>
