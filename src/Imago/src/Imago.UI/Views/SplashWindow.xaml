<Window x:Class="Imago.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imago"
        Height="320" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Opacity="0.9">

    <Grid>
        <!-- Main content area - Catppuccin Mocha Base -->
        <Border Background="#1E1E2E" CornerRadius="2" Margin="8"/>

        <!-- Base border - subtle gray -->
        <Border CornerRadius="2" Margin="8" BorderBrush="#45475A" BorderThickness="1"
                SnapsToDevicePixels="True" UseLayoutRounding="True"/>

        <!-- Orange Glow that follows border - implemented via OpacityMask -->
        <Rectangle x:Name="GlowPath"
                   Margin="8" RadiusX="12" RadiusY="12"
                   StrokeThickness="1.5"
                   StrokeDashCap="Round">
            <Rectangle.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF6B35" Offset="0"/>
                    <GradientStop Color="#FF8C5A" Offset="0.5"/>
                    <GradientStop Color="#FFAB76" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Stroke>
            <Rectangle.Effect>
                <DropShadowEffect Color="#FF6B35" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
            </Rectangle.Effect>
            <Rectangle.OpacityMask>
                <RadialGradientBrush x:Name="GlowMask"
                                     MappingMode="Absolute"
                                     Center="0,0"
                                     GradientOrigin="0,0"
                                     RadiusX="100" RadiusY="100">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- Inner content -->
        <Border CornerRadius="2" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- Imago Logo Icon -->
                <Viewbox Grid.Row="0" Width="80" Height="80"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,30,0,0">
                    <Canvas Width="24" Height="24">
                        <!-- Simple camera/image icon -->
                        <Path Fill="#FF6B35" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"/>
                    </Canvas>
                </Viewbox>

                <!-- Welcome Text -->
                <TextBlock Grid.Row="1"
                           Text="Imago"
                           FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
                           FontSize="28"
                           FontWeight="Light"
                           Foreground="#CDD6F4"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>

                <!-- Tagline -->
                <TextBlock Grid.Row="2"
                           Text="Professional Image Editor"
                           FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
                           FontSize="14"
                           Foreground="#A6ADC8"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

                <!-- Status Text -->
                <TextBlock x:Name="StatusText"
                           Grid.Row="3"
                           Text="Loading..."
                           FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
                           FontSize="12"
                           Foreground="#6C7086"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,16"/>

                <!-- Version -->
                <TextBlock x:Name="VersionText"
                           Grid.Row="4"
                           Text="Version 0.1.0"
                           FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
                           FontSize="10"
                           Foreground="#45475A"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
