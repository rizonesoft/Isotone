<Window
    x:Class="Imago.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Imago.UI.Controls"
    xmlns:vm="clr-namespace:Imago.UI.ViewModels"
    mc:Ignorable="d"
    Title="Imago"
    Width="1280"
    Height="800"
    MinWidth="800"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource BaseBrush}"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <!-- Pure Grey Colors -->
        <Color x:Key="Base">#1E1E1E</Color>
        <Color x:Key="Mantle">#181818</Color>
        <Color x:Key="Crust">#111111</Color>
        <Color x:Key="Surface0">#2D2D2D</Color>
        <Color x:Key="Surface1">#3D3D3D</Color>
        <Color x:Key="Surface2">#4D4D4D</Color>
        <Color x:Key="Overlay0">#6D6D6D</Color>
        <Color x:Key="Text">#E0E0E0</Color>
        <Color x:Key="Subtext0">#A0A0A0</Color>
        <Color x:Key="Blue">#89B4FA</Color>
        <Color x:Key="Green">#A6E3A1</Color>
        <Color x:Key="Peach">#FAB387</Color>
        <Color x:Key="Red">#F38BA8</Color>

        <!-- Orange Accent -->
        <Color x:Key="AccentOrange">#FF6B35</Color>
        <Color x:Key="AccentOrangeLight">#FF8C5A</Color>

        <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource Base}"/>
        <SolidColorBrush x:Key="MantleBrush" Color="{StaticResource Mantle}"/>
        <SolidColorBrush x:Key="CrustBrush" Color="{StaticResource Crust}"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}"/>
        <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="{StaticResource Subtext0}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentOrange}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentOrangeLight}"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}"/>
        <SolidColorBrush x:Key="Overlay0Brush" Color="{StaticResource Overlay0}"/>

        <!-- Orange Gradient -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B35" Offset="0"/>
            <GradientStop Color="#FF8C5A" Offset="0.5"/>
            <GradientStop Color="#FFAB76" Offset="1"/>
        </LinearGradientBrush>

        <!-- Override System Colors -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Base}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Surface0}"/>

        <!-- Active Tool Button Style (RadioButton as tool selector) -->
        <Style x:Key="ActiveToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Tools"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1AFF6B35"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF6B35" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#2AFF6B35"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Simple Tool Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource CrustBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel Header Style -->
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <!-- Menu Bar -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource MantleBrush}" Foreground="{StaticResource TextBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="_Export..." InputGestureText="Ctrl+E" Command="{Binding ExportCommand}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}" />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                <Separator />
                <MenuItem Header="_Preferences..." Command="{Binding PreferencesCommand}" />
            </MenuItem>

            <MenuItem Header="_Image">
                <MenuItem Header="Image _Size..." Command="{Binding ImageSizeCommand}" />
                <MenuItem Header="Canvas S_ize..." Command="{Binding CanvasSizeCommand}" />
                <Separator />
                <MenuItem Header="_Rotate Canvas">
                    <MenuItem Header="90° Clockwise" Command="{Binding RotateClockwiseCommand}" />
                    <MenuItem Header="90° Counter-Clockwise" Command="{Binding RotateCounterClockwiseCommand}" />
                    <MenuItem Header="180°" Command="{Binding Rotate180Command}" />
                </MenuItem>
                <MenuItem Header="_Flip Canvas">
                    <MenuItem Header="Flip Horizontal" Command="{Binding FlipHorizontalCommand}" />
                    <MenuItem Header="Flip Vertical" Command="{Binding FlipVerticalCommand}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Layer">
                <MenuItem Header="_New Layer" InputGestureText="Ctrl+Shift+N" Command="{Binding NewLayerCommand}" />
                <MenuItem Header="_Duplicate Layer" InputGestureText="Ctrl+J" Command="{Binding DuplicateLayerCommand}" />
                <MenuItem Header="De_lete Layer" Command="{Binding DeleteLayerCommand}" />
                <Separator />
                <MenuItem Header="_Merge Down" InputGestureText="Ctrl+E" Command="{Binding MergeDownCommand}" />
                <MenuItem Header="Flatten _Image" Command="{Binding FlattenImageCommand}" />
            </MenuItem>

            <MenuItem Header="_Filter">
                <MenuItem Header="_Blur">
                    <MenuItem Header="Gaussian Blur..." Command="{Binding GaussianBlurCommand}" />
                    <MenuItem Header="Motion Blur..." Command="{Binding MotionBlurCommand}" />
                    <MenuItem Header="Surface Blur..." Command="{Binding SurfaceBlurCommand}" />
                </MenuItem>
                <MenuItem Header="_Sharpen">
                    <MenuItem Header="Unsharp Mask..." Command="{Binding UnsharpMaskCommand}" />
                    <MenuItem Header="Smart Sharpen..." Command="{Binding SmartSharpenCommand}" />
                </MenuItem>
                <MenuItem Header="_Noise">
                    <MenuItem Header="Add Noise..." Command="{Binding AddNoiseCommand}" />
                    <MenuItem Header="Reduce Noise..." Command="{Binding ReduceNoiseCommand}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Zoom In" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" />
                <MenuItem Header="_Fit to Window" InputGestureText="Ctrl+0" Command="{Binding FitToWindowCommand}" />
                <MenuItem Header="_Actual Size" InputGestureText="Ctrl+1" Command="{Binding ActualSizeCommand}" />
                <Separator />
                <MenuItem Header="Show _Rulers" IsCheckable="True" IsChecked="{Binding ShowRulers}" />
                <MenuItem Header="Show _Grid" IsCheckable="True" IsChecked="{Binding ShowGrid}" />
                <MenuItem Header="Show G_uides" IsCheckable="True" IsChecked="{Binding ShowGuides}" />
            </MenuItem>

            <MenuItem Header="_Window">
                <MenuItem Header="_Layers" IsCheckable="True" IsChecked="{Binding ShowLayersPanel}" />
                <MenuItem Header="_Properties" IsCheckable="True" IsChecked="{Binding ShowPropertiesPanel}" />
                <MenuItem Header="_History" IsCheckable="True" IsChecked="{Binding ShowHistoryPanel}" />
                <MenuItem Header="_Navigator" IsCheckable="True" IsChecked="{Binding ShowNavigatorPanel}" />
                <MenuItem Header="_Color" IsCheckable="True" IsChecked="{Binding ShowColorPanel}" />
                <Separator />
                <MenuItem Header="Reset Workspace" Command="{Binding ResetWorkspaceCommand}" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" Command="{Binding DocumentationCommand}" />
                <MenuItem Header="_Keyboard Shortcuts" InputGestureText="Ctrl+Shift+?" Command="{Binding KeyboardShortcutsCommand}" />
                <Separator />
                <MenuItem Header="_About Imago" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource MantleBrush}" Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="New Document (Ctrl+N)" Command="{Binding NewDocumentCommand}">
                    <controls:VectorIcon Icon="FilePlus" Size="16"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Open Document (Ctrl+O)" Command="{Binding OpenDocumentCommand}">
                    <controls:VectorIcon Icon="FolderOpen" Size="16"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Save Document (Ctrl+S)" Command="{Binding SaveDocumentCommand}">
                    <controls:VectorIcon Icon="Save" Size="16"/>
                </Button>

                <Separator Margin="8,4" />

                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}">
                    <controls:VectorIcon Icon="RotateCcw" Size="16"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}">
                    <controls:VectorIcon Icon="RotateCw" Size="16"/>
                </Button>

                <Separator Margin="8,4" />

                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Zoom In (Ctrl++)" Command="{Binding ZoomInCommand}">
                    <controls:VectorIcon Icon="ZoomIn" Size="16"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Zoom Out (Ctrl+-)" Command="{Binding ZoomOutCommand}">
                    <controls:VectorIcon Icon="ZoomOut" Size="16"/>
                </Button>
                <TextBlock
                    Text="{Binding ZoomLevel, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource TextBrush}"
                    Margin="8,0"
                    MinWidth="50" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Tools Panel -->
                <ColumnDefinition Width="46" />
                <!-- Left Panel (Layers, etc.) -->
                <ColumnDefinition Width="280" />
                <!-- Canvas -->
                <ColumnDefinition Width="*" />
                <!-- Right Panel (Properties) -->
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Tools Panel -->
            <Border
                Grid.Column="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="3">
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Move Tool (V)" IsChecked="True">
                        <controls:VectorIcon Icon="Move" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Selection Tool (M)">
                        <controls:VectorIcon Icon="Square" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Brush Tool (B)">
                        <controls:VectorIcon Icon="Brush" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Pencil Tool (P)">
                        <controls:VectorIcon Icon="Pencil" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Eraser Tool (E)">
                        <controls:VectorIcon Icon="Eraser" Size="18"/>
                    </RadioButton>
                    <Separator Margin="2,6" Background="{StaticResource Surface0Brush}"/>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Color Picker (I)">
                        <controls:VectorIcon Icon="Pipette" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Paint Bucket (G)">
                        <controls:VectorIcon Icon="Droplet" Size="18" IsFilled="True"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Text Tool (T)">
                        <controls:VectorIcon Icon="Type" Size="18"/>
                    </RadioButton>
                    <Separator Margin="2,6" Background="{StaticResource Surface0Brush}"/>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Crop Tool (C)">
                        <controls:VectorIcon Icon="Crop" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Hand Tool (H)">
                        <controls:VectorIcon Icon="Hand" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Zoom Tool (Z)">
                        <controls:VectorIcon Icon="ZoomIn" Size="18"/>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Left Panel - Layers -->
            <Border
                Grid.Column="1"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10" Background="{StaticResource Surface0Brush}">
                        <TextBlock Text="LAYERS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtextBrush}"/>
                    </Border>

                    <Border Grid.Row="1" Margin="8">
                        <TextBlock
                            Text="No document open"
                            Foreground="{StaticResource SubtextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Canvas Area -->
            <Border
                Grid.Column="2"
                Background="{StaticResource BaseBrush}">
                <Grid>
                    <!-- Canvas Container with Rulers -->
                    <controls:CanvasContainer
                        x:Name="CanvasContainer"
                        ShowRulers="{Binding ShowRulers}"
                        Visibility="{Binding HasDocument, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                    <!-- Welcome Screen -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasDocument, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                        <controls:VectorIcon
                            Icon="Image"
                            Size="64"
                            Foreground="{StaticResource SubtextBrush}"
                            Margin="0,0,0,16" />
                        <TextBlock
                            Text="Welcome to Imago"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8" />
                        <TextBlock
                            Text="Create a new document or open an existing one to get started"
                            Foreground="{StaticResource SubtextBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button
                                Content="New Document"
                                Command="{Binding NewDocumentCommand}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="{StaticResource CrustBrush}"
                                Padding="16,8"
                                Margin="4" />
                            <Button
                                Content="Open Document"
                                Command="{Binding OpenDocumentCommand}"
                                Background="{StaticResource Surface1Brush}"
                                Foreground="{StaticResource TextBrush}"
                                Padding="16,8"
                                Margin="4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Panel - Properties -->
            <Border
                Grid.Column="3"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10" Background="{StaticResource Surface0Brush}">
                        <TextBlock Text="PROPERTIES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtextBrush}"/>
                    </Border>

                    <Border Grid.Row="1" Margin="8">
                        <TextBlock
                            Text="Select a layer to view properties"
                            Foreground="{StaticResource SubtextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border
            Grid.Row="3"
            Background="{StaticResource MantleBrush}"
            Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="{Binding StatusMessage, FallbackValue='Ready'}"
                    FontSize="11"
                    Foreground="{StaticResource SubtextBrush}"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding CursorPosition, StringFormat='X: {0}', FallbackValue='X: 0, Y: 0'}"
                    FontSize="11"
                    Foreground="{StaticResource SubtextBrush}"
                    VerticalAlignment="Center"
                    Margin="16,0" />

                <TextBlock
                    Grid.Column="2"
                    Text="{Binding DocumentSize, FallbackValue='1920 x 1080 px'}"
                    FontSize="11"
                    Foreground="{StaticResource SubtextBrush}"
                    VerticalAlignment="Center"
                    Margin="16,0" />

                <TextBlock
                    Grid.Column="3"
                    Text="{Binding MemoryUsage, StringFormat='Memory: {0} MB'}"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Overlay0Brush}" />
            </Grid>
        </Border>
    </Grid>

</Window>
