<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Imago.Rendering</RootNamespace>
    <AssemblyName>Imago.Rendering</AssemblyName>
    <Description>GPU-accelerated rendering engine using SkiaSharp and ComputeSharp</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
    <PackageReference Include="ComputeSharp" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Imago.Core\Imago.Core.csproj" />
  </ItemGroup>

</Project>
