<ui:FluentWindow x:Class="Bezier.Desktop.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:fi="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:avalondock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalontheme="clr-namespace:AvalonDock.Themes.VS2013;assembly=AvalonDock.Themes.VS2013"
        xmlns:canvas="clr-namespace:Bezier.Desktop.Controls.Canvas"
        Title="Bezier" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/Resources/Icons/Bezier.ico">
    
    <ui:FluentWindow.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Catppuccin Mocha Colors -->
        <Color x:Key="Base">#1E1E2E</Color>
        <Color x:Key="Mantle">#181825</Color>
        <Color x:Key="Crust">#11111B</Color>
        <Color x:Key="Surface0">#313244</Color>
        <Color x:Key="Surface1">#45475A</Color>
        <Color x:Key="Surface2">#585B70</Color>
        <Color x:Key="Overlay0">#6C7086</Color>
        <Color x:Key="Text">#CDD6F4</Color>
        <Color x:Key="Subtext0">#A6ADC8</Color>
        <Color x:Key="Blue">#89B4FA</Color>
        <Color x:Key="Lavender">#B4BEFE</Color>
        <Color x:Key="Sapphire">#74C7EC</Color>
        <Color x:Key="Green">#A6E3A1</Color>
        <Color x:Key="Peach">#FAB387</Color>
        <Color x:Key="Flamingo">#F2CDCD</Color>
        <Color x:Key="Maroon">#EBA0AC</Color>
        <Color x:Key="Red">#F38BA8</Color>
        
        <!-- Modern Orange Accent -->
        <Color x:Key="AccentOrange">#FF6B35</Color>
        <Color x:Key="AccentOrangeLight">#FF8C5A</Color>
        <Color x:Key="AccentOrangeDark">#E85A2A</Color>
        
        <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource Base}"/>
        <SolidColorBrush x:Key="MantleBrush" Color="{StaticResource Mantle}"/>
        <SolidColorBrush x:Key="CrustBrush" Color="{StaticResource Crust}"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}"/>
        <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="{StaticResource Subtext0}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentOrange}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentOrangeLight}"/>
        
        <!-- Orange Gradient Brush -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B35" Offset="0"/>
            <GradientStop Color="#FF8C5A" Offset="0.5"/>
            <GradientStop Color="#FFAB76" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Override AvalonDock colors -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Base}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Surface0}"/>
        
        <!-- Tool Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource CrustBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Toggle Tool Button Style -->
        <Style x:Key="ToggleToolButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MantleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Active Tool Button Style (RadioButton as tool selector) -->
        <Style x:Key="ActiveToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Tools"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="2"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Collapsible Panel Header Style -->
        <Style x:Key="CollapsibleHeaderStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <fi:FluentIcon x:Name="chevron" Icon="ChevronDown" IconSize="Size12" FontSize="10" 
                                               Foreground="{StaticResource SubtextBrush}" Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding Tag}" 
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="chevron" Property="Icon" Value="ChevronRight"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Enhanced Tooltip Style -->
        <Style x:Key="ToolTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <!-- File -->
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseCommand}"/>
        
        <!-- Edit -->
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}"/>
        
        <!-- View -->
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding FitToWindowCommand}"/>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ActualSizeCommand}"/>
        
        <!-- Object -->
        <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding GroupCommand}"/>
        <KeyBinding Key="G" Modifiers="Ctrl+Shift" Command="{Binding UngroupCommand}"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Ctrl+Shift" Command="{Binding BringToFrontCommand}"/>
        <KeyBinding Key="OemCloseBrackets" Modifiers="Ctrl" Command="{Binding BringForwardCommand}"/>
        <KeyBinding Key="OemOpenBrackets" Modifiers="Ctrl" Command="{Binding SendBackwardCommand}"/>
        <KeyBinding Key="OemOpenBrackets" Modifiers="Ctrl+Shift" Command="{Binding SendToBackCommand}"/>
        
        <!-- Help -->
        <KeyBinding Key="F1" Command="{Binding DocumentationCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid Background="{StaticResource MantleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar with integrated menu -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Bezier"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="-32,0,0,0">
                    <!-- App Icon - pushed to far left -->
                    <Border Width="52" Background="Transparent">
                        <Image Source="pack://application:,,,/Resources/Icons/Bezier_32.png" 
                               Width="20" Height="20" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Menu Background="Transparent" Foreground="{StaticResource TextBrush}">
                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>
                        
                        <!-- File Menu -->
                        <MenuItem Header="_File" Foreground="{StaticResource TextBrush}">
                            <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}"/>
                            <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                            <MenuItem Header="Open _Recent">
                                <MenuItem Header="(No recent files)"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                            <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
                            <Separator/>
                            <MenuItem Header="_Export">
                                <MenuItem Header="Export as _PNG..." Command="{Binding ExportPngCommand}"/>
                                <MenuItem Header="Export as _JPEG..." Command="{Binding ExportJpegCommand}"/>
                                <MenuItem Header="Export as P_DF..." Command="{Binding ExportPdfCommand}"/>
                                <MenuItem Header="Export as _XAML..." Command="{Binding ExportXamlCommand}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="_Close" InputGestureText="Ctrl+W" Command="{Binding CloseCommand}"/>
                            <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}"/>
                        </MenuItem>
                        
                        <!-- Edit Menu -->
                        <MenuItem Header="_Edit" Foreground="{StaticResource TextBrush}">
                            <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                            <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"/>
                            <Separator/>
                            <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}"/>
                            <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}"/>
                            <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}"/>
                            <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}"/>
                            <Separator/>
                            <MenuItem Header="De_lete" InputGestureText="Del" Command="{Binding DeleteCommand}"/>
                            <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                            <Separator/>
                            <MenuItem Header="Pr_eferences..." Command="{Binding PreferencesCommand}"/>
                        </MenuItem>
                        
                        <!-- View Menu -->
                        <MenuItem Header="_View" Foreground="{StaticResource TextBrush}">
                            <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}"/>
                            <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}"/>
                            <MenuItem Header="_Fit to Window" InputGestureText="Ctrl+0" Command="{Binding FitToWindowCommand}"/>
                            <MenuItem Header="_Actual Size" InputGestureText="Ctrl+1" Command="{Binding ActualSizeCommand}"/>
                            <Separator/>
                            <MenuItem Header="Show _Grid" InputGestureText="Ctrl+'" IsCheckable="True" IsChecked="{Binding ShowGrid}"/>
                            <MenuItem Header="Show _Rulers" IsCheckable="True" IsChecked="{Binding ShowRulers}"/>
                            <MenuItem Header="Show G_uides" IsCheckable="True" IsChecked="{Binding ShowGuides}"/>
                            <Separator/>
                            <MenuItem Header="_Outline Mode" IsCheckable="True" IsChecked="{Binding OutlineMode}"/>
                        </MenuItem>
                        
                        <!-- Window Menu -->
                        <MenuItem Header="_Window" Foreground="{StaticResource TextBrush}">
                            <MenuItem Header="_Tools Panel" IsCheckable="True" IsChecked="{Binding ShowToolsPanel}"/>
                            <MenuItem Header="_Properties Panel" IsCheckable="True" IsChecked="{Binding ShowPropertiesPanel}"/>
                            <MenuItem Header="_Layers Panel" IsCheckable="True" IsChecked="{Binding ShowLayersPanel}"/>
                            <MenuItem Header="_History Panel" IsCheckable="True" IsChecked="{Binding ShowHistoryPanel}"/>
                            <MenuItem Header="_Code Editor" IsCheckable="True" IsChecked="{Binding ShowCodePanel}"/>
                            <Separator/>
                            <MenuItem Header="_Reset Layout" Command="{Binding ResetLayoutCommand}"/>
                        </MenuItem>
                        
                        <!-- Object Menu -->
                        <MenuItem Header="_Object" Foreground="{StaticResource TextBrush}">
                            <MenuItem Header="_Group" InputGestureText="Ctrl+G" Command="{Binding GroupCommand}"/>
                            <MenuItem Header="_Ungroup" InputGestureText="Ctrl+Shift+G" Command="{Binding UngroupCommand}"/>
                            <Separator/>
                            <MenuItem Header="Bring to _Front" InputGestureText="Ctrl+Shift+]" Command="{Binding BringToFrontCommand}"/>
                            <MenuItem Header="Bring For_ward" InputGestureText="Ctrl+]" Command="{Binding BringForwardCommand}"/>
                            <MenuItem Header="Send _Backward" InputGestureText="Ctrl+[" Command="{Binding SendBackwardCommand}"/>
                            <MenuItem Header="Send to _Back" InputGestureText="Ctrl+Shift+[" Command="{Binding SendToBackCommand}"/>
                            <Separator/>
                            <MenuItem Header="_Align">
                                <MenuItem Header="Align _Left" Command="{Binding AlignLeftCommand}"/>
                                <MenuItem Header="Align _Center" Command="{Binding AlignCenterCommand}"/>
                                <MenuItem Header="Align _Right" Command="{Binding AlignRightCommand}"/>
                                <Separator/>
                                <MenuItem Header="Align _Top" Command="{Binding AlignTopCommand}"/>
                                <MenuItem Header="Align _Middle" Command="{Binding AlignMiddleCommand}"/>
                                <MenuItem Header="Align _Bottom" Command="{Binding AlignBottomCommand}"/>
                            </MenuItem>
                            <MenuItem Header="_Distribute">
                                <MenuItem Header="Distribute _Horizontally" Command="{Binding DistributeHorizontallyCommand}"/>
                                <MenuItem Header="Distribute _Vertically" Command="{Binding DistributeVerticallyCommand}"/>
                            </MenuItem>
                            <MenuItem Header="_Transform">
                                <MenuItem Header="_Rotate 90° CW" Command="{Binding Rotate90CwCommand}"/>
                                <MenuItem Header="Rotate 90° CC_W" Command="{Binding Rotate90CcwCommand}"/>
                                <MenuItem Header="Rotate _180°" Command="{Binding Rotate180Command}"/>
                                <Separator/>
                                <MenuItem Header="Flip _Horizontal" Command="{Binding FlipHorizontalCommand}"/>
                                <MenuItem Header="Flip _Vertical" Command="{Binding FlipVerticalCommand}"/>
                            </MenuItem>
                        </MenuItem>
                        
                        <!-- Path Menu -->
                        <MenuItem Header="_Path" Foreground="{StaticResource TextBrush}">
                            <MenuItem Header="_Union" Command="{Binding UnionCommand}"/>
                            <MenuItem Header="_Subtract" Command="{Binding SubtractCommand}"/>
                            <MenuItem Header="_Intersect" Command="{Binding IntersectCommand}"/>
                            <MenuItem Header="E_xclude" Command="{Binding ExcludeCommand}"/>
                            <Separator/>
                            <MenuItem Header="Si_mplify" Command="{Binding SimplifyCommand}"/>
                            <MenuItem Header="Stroke to _Path" Command="{Binding StrokeToPathCommand}"/>
                            <MenuItem Header="_Text to Path" Command="{Binding TextToPathCommand}"/>
                        </MenuItem>
                        
                        <!-- Help Menu -->
                        <MenuItem Header="_Help" Foreground="{StaticResource TextBrush}">
                            <MenuItem Header="_Documentation" InputGestureText="F1" Command="{Binding DocumentationCommand}"/>
                            <MenuItem Header="_Keyboard Shortcuts" Command="{Binding KeyboardShortcutsCommand}"/>
                            <Separator/>
                            <MenuItem Header="_Check for Updates" Command="{Binding CheckUpdatesCommand}"/>
                            <Separator/>
                            <MenuItem Header="_About Bezier" Command="{Binding AboutCommand}"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource CrustBrush}" 
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <!-- File Operations -->
                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="New (Ctrl+N)" 
                        Command="{Binding NewCommand}" Width="32" Height="28">
                    <fi:FluentIcon Icon="DocumentAdd" IconSize="Size24" FontSize="20" IconVariant="Regular" Foreground="{StaticResource SubtextBrush}"/>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Open (Ctrl+O)" 
                        Command="{Binding OpenCommand}" Width="32" Height="28">
                    <fi:FluentIcon Icon="FolderOpen" IconSize="Size24" FontSize="20" IconVariant="Regular" Foreground="{StaticResource SubtextBrush}"/>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Save (Ctrl+S)" 
                        Command="{Binding SaveCommand}" Width="32" Height="28">
                    <fi:FluentIcon Icon="Save" IconSize="Size24" FontSize="20" IconVariant="Regular" Foreground="{StaticResource SubtextBrush}"/>
                </Button>
                
                <!-- Separator -->
                <Border Width="1" Background="{StaticResource Surface0Brush}" Margin="8,4"/>
                
                <!-- Edit Operations -->
                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Undo (Ctrl+Z)" 
                        Command="{Binding UndoCommand}" Width="32" Height="28">
                    <fi:FluentIcon Icon="ArrowUndo" IconSize="Size24" FontSize="20" IconVariant="Regular" Foreground="{StaticResource SubtextBrush}"/>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Redo (Ctrl+Y)" 
                        Command="{Binding RedoCommand}" Width="32" Height="28">
                    <fi:FluentIcon Icon="ArrowRedo" IconSize="Size24" FontSize="20" IconVariant="Regular" Foreground="{StaticResource SubtextBrush}"/>
                </Button>
                
                <!-- Separator -->
                <Border Width="1" Background="{StaticResource Surface0Brush}" Margin="8,4"/>
                
                <!-- Zoom Controls -->
                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Zoom Out (Ctrl+-)" 
                        Command="{Binding ZoomOutCommand}" Width="28" Height="28">
                    <fi:FluentIcon Icon="Subtract" IconSize="Size20" FontSize="16" IconVariant="Regular" Foreground="{StaticResource SubtextBrush}"/>
                </Button>
                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" 
                        Padding="8,4" Margin="2,0" MinWidth="55">
                    <TextBlock Text="{Binding ZoomLevel, StringFormat={}{0}%}" 
                               Foreground="{StaticResource TextBrush}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Zoom In (Ctrl++)" 
                        Command="{Binding ZoomInCommand}" Width="28" Height="28">
                    <fi:FluentIcon Icon="Add" IconSize="Size20" FontSize="16" IconVariant="Regular" Foreground="{StaticResource SubtextBrush}"/>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Fit to Window (Ctrl+0)" 
                        Command="{Binding FitToWindowCommand}" Width="32" Height="28">
                    <fi:FluentIcon Icon="FullScreenMaximize" IconSize="Size24" FontSize="20" IconVariant="Regular" Foreground="{StaticResource SubtextBrush}"/>
                </Button>
                
                <!-- Separator -->
                <Border Width="1" Background="{StaticResource Surface0Brush}" Margin="8,4"/>
                
                <!-- View Toggles -->
                <ToggleButton Style="{StaticResource ToggleToolButtonStyle}" ToolTip="Toggle Grid (Ctrl+')" 
                              IsChecked="{Binding ShowGrid}" Width="32" Height="28">
                    <fi:FluentIcon Icon="Grid" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToggleToolButtonStyle}" ToolTip="Toggle Rulers" 
                              IsChecked="{Binding ShowRulers}" Width="32" Height="28">
                    <fi:FluentIcon Icon="TextAlignJustifyLow" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToggleToolButtonStyle}" ToolTip="Toggle Snap" 
                              IsChecked="{Binding SnapEnabled}" Width="32" Height="28">
                    <fi:FluentIcon Icon="Target" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Toolbox -->
            <Border Grid.Column="0" Background="{StaticResource CrustBrush}" 
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowToolsPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="4,8">
                    <!-- Selection Tools -->
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" IsChecked="{Binding IsSelectToolActive}"
                                 Command="{Binding SetToolCommand}" CommandParameter="Select">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTooltipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Select Tool" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="V" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Click to select, drag to move" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                        <fi:FluentIcon Icon="Cursor" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                    </RadioButton>
                    
                    <!-- Drawing Tools -->
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" IsChecked="{Binding IsPenToolActive}"
                                 Command="{Binding SetToolCommand}" CommandParameter="Pen">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTooltipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Pen Tool" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="P" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Draw bezier curves and paths" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                        <fi:FluentIcon Icon="Pen" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" IsChecked="{Binding IsRectangleToolActive}"
                                 Command="{Binding SetToolCommand}" CommandParameter="Rectangle">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTooltipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Rectangle Tool" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="R" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Draw rectangles and squares" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                        <fi:FluentIcon Icon="Square" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" IsChecked="{Binding IsEllipseToolActive}"
                                 Command="{Binding SetToolCommand}" CommandParameter="Ellipse">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTooltipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Ellipse Tool" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="E" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Draw ellipses and circles" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                        <fi:FluentIcon Icon="Circle" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" IsChecked="{Binding IsLineToolActive}"
                                 Command="{Binding SetToolCommand}" CommandParameter="Line">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTooltipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Line Tool" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="L" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Draw straight lines" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                        <fi:FluentIcon Icon="LineHorizontal1" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" IsChecked="{Binding IsTextToolActive}"
                                 Command="{Binding SetToolCommand}" CommandParameter="Text">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTooltipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Text Tool" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="T" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Add and edit text" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                        <fi:FluentIcon Icon="TextT" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                    </RadioButton>
                    
                    <Separator Background="{StaticResource Surface0Brush}" Margin="8,12"/>
                    
                    <!-- Navigation Tools -->
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" IsChecked="{Binding IsZoomToolActive}"
                                 Command="{Binding SetToolCommand}" CommandParameter="Zoom">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTooltipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Zoom Tool" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="Z" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Click to zoom in, Alt+click to zoom out" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                        <fi:FluentIcon Icon="ZoomIn" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" IsChecked="{Binding IsPanToolActive}"
                                 Command="{Binding SetToolCommand}" CommandParameter="Pan">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTooltipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Pan Tool" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="H" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Drag to pan the canvas" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ToolTip>
                        </RadioButton.ToolTip>
                        <fi:FluentIcon Icon="HandLeft" IconSize="Size24" FontSize="20" IconVariant="Regular"/>
                    </RadioButton>
                </StackPanel>
            </Border>
            
            <!-- Center: Canvas Area -->
            <canvas:SkiaCanvas x:Name="MainCanvas" Grid.Column="1"
                               Document="{Binding Document}"
                               ShowGrid="{Binding ShowGrid}"
                               ShowRulers="{Binding ShowRulers}"
                               OutlineMode="{Binding OutlineMode}"
                               CursorPositionChanged="MainCanvas_CursorPositionChanged"
                               ZoomChanged="MainCanvas_ZoomChanged"/>
            
            <!-- Right: Properties Panel -->
            <Border Grid.Column="2" Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowPropertiesPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Properties Header -->
                        <Border Background="{StaticResource MantleBrush}" Padding="12,10">
                            <TextBlock Text="PROPERTIES" 
                                       FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{StaticResource SubtextBrush}"/>
                        </Border>
                        
                        <StackPanel Margin="12,8">
                            <!-- Appearance Section -->
                            <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold" 
                                       Foreground="{StaticResource SubtextBrush}" Margin="0,8,0,8"/>
                            
                            <!-- Fill -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fill" Foreground="{StaticResource TextBrush}" 
                                           VerticalAlignment="Center" FontSize="12"/>
                                <Border Grid.Column="1" Background="{StaticResource Surface0Brush}" 
                                        CornerRadius="4" Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="3">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource Blue}"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="#89B4FA" Foreground="{StaticResource TextBrush}" 
                                                   VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                                                   FontFamily="Consolas"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Stroke -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stroke" Foreground="{StaticResource TextBrush}" 
                                           VerticalAlignment="Center" FontSize="12"/>
                                <Border Grid.Column="1" Background="{StaticResource Surface0Brush}" 
                                        CornerRadius="4" Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="3" 
                                                BorderBrush="{StaticResource TextBrush}" BorderThickness="2"/>
                                        <TextBlock Text="None" Foreground="{StaticResource SubtextBrush}" 
                                                   VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Transform Section -->
                            <TextBlock Text="TRANSFORM" FontSize="10" FontWeight="SemiBold" 
                                       Foreground="{StaticResource SubtextBrush}" Margin="0,16,0,8"/>
                            
                            <!-- Position -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="X" Foreground="{StaticResource SubtextBrush}" FontSize="10" Width="14"/>
                                        <TextBlock Text="0" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Y" Foreground="{StaticResource SubtextBrush}" FontSize="10" Width="14"/>
                                        <TextBlock Text="0" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Size -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="W" Foreground="{StaticResource SubtextBrush}" FontSize="10" Width="14"/>
                                        <TextBlock Text="100" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="H" Foreground="{StaticResource SubtextBrush}" FontSize="10" Width="14"/>
                                        <TextBlock Text="100" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Layers Header -->
                        <Border Background="{StaticResource MantleBrush}" Padding="12,10" Margin="0,16,0,0"
                                Visibility="{Binding ShowLayersPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <TextBlock Text="LAYERS" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource SubtextBrush}"/>
                                <TextBlock Text="{Binding ElementCount}" FontSize="10" 
                                           Foreground="{StaticResource SubtextBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        
                        <StackPanel Margin="8" Visibility="{Binding ShowLayersPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Layer items bound to document elements -->
                            <ItemsControl ItemsSource="{Binding Document.Elements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" 
                                                Padding="8,6" Margin="0,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <fi:FluentIcon Icon="Eye" IconSize="Size16" FontSize="12" 
                                                               Foreground="{StaticResource SubtextBrush}" Margin="0,0,8,0"
                                                               Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Name, TargetNullValue='Element'}" 
                                                           Foreground="{StaticResource TextBrush}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No elements" Foreground="{StaticResource SubtextBrush}" 
                                       FontSize="11" FontStyle="Italic" Margin="4,8"
                                       Visibility="{Binding Document.Elements.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"/>
                        </StackPanel>
                        
                        <!-- History Header -->
                        <Border Background="{StaticResource MantleBrush}" Padding="12,10" Margin="0,16,0,0"
                                Visibility="{Binding ShowHistoryPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <TextBlock Text="HISTORY" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource SubtextBrush}"/>
                                <Button Style="{StaticResource ToolButtonStyle}" 
                                        Command="{Binding ClearHistoryCommand}"
                                        ToolTip="Clear History"
                                        HorizontalAlignment="Right" Width="20" Height="20" Margin="0,-4">
                                    <fi:FluentIcon Icon="Delete" IconSize="Size12" FontSize="10" 
                                                   Foreground="{StaticResource SubtextBrush}"/>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <StackPanel Margin="8" Visibility="{Binding ShowHistoryPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- History items -->
                            <ItemsControl ItemsSource="{Binding UndoHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" 
                                                Padding="8,6" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:FluentIcon Icon="History" IconSize="Size16" FontSize="12" 
                                                               Foreground="{StaticResource SubtextBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" 
                                                           Foreground="{StaticResource TextBrush}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No history" Foreground="{StaticResource SubtextBrush}" 
                                       FontSize="11" FontStyle="Italic" Margin="4,8"
                                       Visibility="{Binding CanUndo, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource CrustBrush}" 
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0" 
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Status and Selection Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,20,0"/>
                    <Border Width="1" Height="12" Background="{StaticResource Surface1Brush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding SelectionInfo}" Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
                </StackPanel>
                
                <!-- Right: Cursor Position, Zoom, Document Size -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Cursor Position -->
                    <fi:FluentIcon Icon="CursorClick" IconSize="Size16" FontSize="12" Foreground="{StaticResource SubtextBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CursorPosition}" Foreground="{StaticResource SubtextBrush}" FontSize="11" 
                               FontFamily="Consolas" MinWidth="70" Margin="0,0,16,0"/>
                    
                    <Border Width="1" Height="12" Background="{StaticResource Surface1Brush}" Margin="0,0,12,0"/>
                    
                    <!-- Zoom Level -->
                    <fi:FluentIcon Icon="ZoomIn" IconSize="Size16" FontSize="12" Foreground="{StaticResource SubtextBrush}" Margin="0,0,4,0"/>
                    <TextBlock Foreground="{StaticResource SubtextBrush}" FontSize="11" MinWidth="40" Margin="0,0,16,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}%">
                                <Binding Path="ZoomLevel"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <Border Width="1" Height="12" Background="{StaticResource Surface1Brush}" Margin="0,0,12,0"/>
                    
                    <!-- Element Count -->
                    <fi:FluentIcon Icon="Layer" IconSize="Size16" FontSize="12" Foreground="{StaticResource SubtextBrush}" Margin="0,0,4,0"/>
                    <TextBlock Foreground="{StaticResource SubtextBrush}" FontSize="11" MinWidth="30" Margin="0,0,16,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="ElementCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <Border Width="1" Height="12" Background="{StaticResource Surface1Brush}" Margin="0,0,12,0"/>
                    
                    <!-- Document Size -->
                    <fi:FluentIcon Icon="Document" IconSize="Size16" FontSize="12" Foreground="{StaticResource SubtextBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding DocumentSize}" Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Error Toast -->
        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#E85A2A" CornerRadius="6" Padding="16,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <fi:FluentIcon Icon="ErrorCircle" IconSize="Size20" Foreground="White" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="12" VerticalAlignment="Center" MaxWidth="400" TextWrapping="Wrap"/>
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding DismissErrorCommand}" 
                        Width="24" Height="24" Margin="12,0,0,0" ToolTip="Dismiss">
                    <fi:FluentIcon Icon="Dismiss" IconSize="Size16" Foreground="White"/>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Loading Overlay -->
        <Border Grid.Row="2" Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="Loading..." Foreground="White" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
