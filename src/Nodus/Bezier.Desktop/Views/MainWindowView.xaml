<Window x:Class="Bezier.Desktop.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:vm="clr-namespace:Bezier.Desktop.ViewModels"
        Title="Bezier - SVG Optimizer" 
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBg" Color="#252526"/>
        <SolidColorBrush x:Key="EditorBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1C97EA"/>
        <SolidColorBrush x:Key="TextMain" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextDim" Color="#858585"/>
        <SolidColorBrush x:Key="Border" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="BtnHover" Color="#505050"/>
        <SolidColorBrush x:Key="Success" Color="#4EC9B0"/>
        
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BtnHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BtnHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBg}" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◇" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Bezier" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="📂 Open" Style="{StaticResource SecondaryBtn}" Command="{Binding OpenFileCommand}" Margin="4,0"/>
                    <Button Content="💾 Save" Style="{StaticResource SecondaryBtn}" Command="{Binding SaveFileCommand}" Margin="4,0"/>
                    <Button Content="⚡ Optimize" Style="{StaticResource PrimaryBtn}" Command="{Binding OptimizeCommand}" Margin="4,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#3C3C3C" CornerRadius="3" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Original:" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OriginalSize}" Foreground="{StaticResource TextMain}" FontSize="11" Margin="4,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Optimized:" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OptimizedSize}" Foreground="{StaticResource Success}" FontSize="11" Margin="4,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SavingsPercent}" Foreground="{StaticResource Success}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Border}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- View Mode Toggle -->
                        <TextBlock Text="VIEW MODE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="CodeModeBtn" Content="Code" Style="{StaticResource TabBtn}" IsChecked="True" GroupName="ViewMode" Checked="ViewMode_Changed"/>
                            <RadioButton x:Name="VisualModeBtn" Content="Visual" Style="{StaticResource TabBtn}" GroupName="ViewMode" Checked="ViewMode_Changed"/>
                        </StackPanel>
                        
                        <TextBlock Text="OPTIMIZATIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" Margin="0,8,0,8"/>
                        
                        <CheckBox Content="Remove comments" IsChecked="{Binding RemoveComments}"/>
                        <CheckBox Content="Remove metadata" IsChecked="{Binding RemoveMetadata}"/>
                        <CheckBox Content="Remove editor data" IsChecked="{Binding RemoveEditorData}"/>
                        <CheckBox Content="Remove empty groups" IsChecked="{Binding RemoveEmptyGroups}"/>
                        <CheckBox Content="Collapse groups" IsChecked="{Binding CollapseGroups}"/>
                        <CheckBox Content="Round numbers" IsChecked="{Binding RoundNumbers}"/>
                        <CheckBox Content="Minify output" IsChecked="{Binding MinifyOutput}"/>
                        
                        <!-- Element Properties Panel -->
                        <Border x:Name="PropertiesPanel" Visibility="Collapsed" Background="#2D2D2D" CornerRadius="4" Margin="0,16,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="SELECTED ELEMENT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SelectedElementType" Text="None" Foreground="{StaticResource TextMain}" FontSize="12"/>
                                <TextBlock x:Name="SelectedElementId" Text="" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0"/>
                                
                                <TextBlock Text="POSITION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X:" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="PosX" Grid.Column="1" Background="#3C3C3C" Foreground="{StaticResource TextMain}" BorderThickness="0" Padding="4" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="Y:" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="PosY" Grid.Column="3" Background="#3C3C3C" Foreground="{StaticResource TextMain}" BorderThickness="0" Padding="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Code Editor Panel -->
            <Grid x:Name="CodeEditorPanel" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Background="{StaticResource SidebarBg}" Padding="12,8">
                    <Grid>
                        <TextBlock Text="SOURCE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📋" Style="{StaticResource IconBtn}" ToolTip="Copy" Click="CopyCode_Click"/>
                            <Button Content="📄" Style="{StaticResource IconBtn}" ToolTip="Paste" Click="PasteCode_Click"/>
                            <Button Content="↩" Style="{StaticResource IconBtn}" ToolTip="Format" Click="FormatCode_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <avalon:TextEditor x:Name="CodeEditor"
                                   Grid.Row="1"
                                   ShowLineNumbers="True"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="13"
                                   Background="{StaticResource EditorBg}"
                                   Foreground="#D4D4D4"
                                   LineNumbersForeground="#858585"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   TextChanged="CodeEditor_TextChanged"
                                   Padding="8"/>
            </Grid>
            
            <!-- Visual WYSIWYG Editor Panel -->
            <Grid x:Name="VisualEditorPanel" Grid.Column="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Background="{StaticResource SidebarBg}" Padding="12,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VISUAL EDITOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                            <TextBlock Text="(Click to select, drag to move)" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="−" Style="{StaticResource IconBtn}" ToolTip="Zoom Out" Click="ZoomOut_Click"/>
                            <TextBlock x:Name="ZoomLevel" Text="100%" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                            <Button Content="+" Style="{StaticResource IconBtn}" ToolTip="Zoom In" Click="ZoomIn_Click"/>
                            <Button Content="⊡" Style="{StaticResource IconBtn}" ToolTip="Fit to View" Click="ZoomFit_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Border Grid.Row="1" Background="#1A1A1A" ClipToBounds="True">
                    <!-- Checkerboard background -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#2A2A2A">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,16,16"/>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#222222">
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <RectangleGeometry Rect="0,0,8,8"/>
                                                            <RectangleGeometry Rect="8,8,8,8"/>
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Style>
                    
                    <ScrollViewer x:Name="VisualScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>
                            
                            <!-- SVG rendered by SharpVectors -->
                            <Image x:Name="VisualSvgImage" Stretch="None"/>
                            
                            <!-- Overlay canvas for selection handles -->
                            <Canvas x:Name="VisualOverlay" 
                                    Background="Transparent"
                                    MouseLeftButtonDown="VisualOverlay_MouseDown"
                                    MouseMove="VisualOverlay_MouseMove"
                                    MouseLeftButtonUp="VisualOverlay_MouseUp"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Preview Panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Background="{StaticResource SidebarBg}" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Border}" Padding="12,8">
                    <Grid>
                        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                        <Button Content="⟳" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" ToolTip="Refresh" Click="RefreshPreview_Click"/>
                    </Grid>
                </Border>
                
                <Border Grid.Row="1" Background="{StaticResource EditorBg}" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Border}">
                    <Grid>
                        <Rectangle>
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#2D2D2D">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,16,16"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#252526">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,8,8"/>
                                                        <RectangleGeometry Rect="8,8,8,8"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        
                        <Viewbox x:Name="SvgPreviewContainer" Stretch="Uniform" Margin="32">
                            <svgc:SvgViewbox x:Name="SvgPreview"/>
                        </Viewbox>
                        
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Open an SVG file to preview"
                                   Foreground="{StaticResource TextDim}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
            
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource Accent}" Padding="8,4">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontSize="11"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="CursorPosition" Text="Ln 1, Col 1" Foreground="White" FontSize="11" Margin="16,0"/>
                    <TextBlock Text="UTF-8" Foreground="White" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
