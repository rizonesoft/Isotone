<ui:FluentWindow x:Class="Bezier.Desktop.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:avalondock="https://github.com/Dirkster99/AvalonDock"
        Title="Bezier" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    
    <ui:FluentWindow.Resources>
        <!-- Catppuccin Mocha Colors -->
        <Color x:Key="CatppuccinBase">#1E1E2E</Color>
        <Color x:Key="CatppuccinSurface0">#313244</Color>
        <Color x:Key="CatppuccinSurface1">#45475A</Color>
        <Color x:Key="CatppuccinText">#CDD6F4</Color>
        <Color x:Key="CatppuccinSubtext">#A6ADC8</Color>
        <Color x:Key="CatppuccinBlue">#89B4FA</Color>
        <Color x:Key="CatppuccinGreen">#A6E3A1</Color>
        <Color x:Key="CatppuccinRed">#F38BA8</Color>
        
        <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource CatppuccinBase}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource CatppuccinSurface0}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource CatppuccinText}"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="{StaticResource CatppuccinSubtext}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CatppuccinBlue}"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Bezier"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="12,0">
                    <!-- Main Menu -->
                    <Menu Background="Transparent" Foreground="{StaticResource TextBrush}">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New" InputGestureText="Ctrl+N"/>
                            <MenuItem Header="_Open" InputGestureText="Ctrl+O"/>
                            <Separator/>
                            <MenuItem Header="_Save" InputGestureText="Ctrl+S"/>
                            <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S"/>
                            <Separator/>
                            <MenuItem Header="E_xit" InputGestureText="Alt+F4"/>
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="_Undo" InputGestureText="Ctrl+Z"/>
                            <MenuItem Header="_Redo" InputGestureText="Ctrl+Y"/>
                            <Separator/>
                            <MenuItem Header="Cu_t" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="_Copy" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="_Paste" InputGestureText="Ctrl+V"/>
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem Header="Zoom _In" InputGestureText="Ctrl++"/>
                            <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-"/>
                            <MenuItem Header="_Fit to Window" InputGestureText="Ctrl+0"/>
                            <Separator/>
                            <MenuItem Header="Show _Grid" IsCheckable="True"/>
                            <MenuItem Header="Show _Rulers" IsCheckable="True"/>
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="_About Bezier"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Content Area with AvalonDock -->
        <avalondock:DockingManager Grid.Row="1" 
                                   x:Name="DockingManager"
                                   AllowMixedOrientation="True"
                                   Background="{StaticResource BaseBrush}">
            
            <avalondock:LayoutRoot>
                <avalondock:LayoutPanel Orientation="Horizontal">
                    
                    <!-- Left: Toolbox -->
                    <avalondock:LayoutAnchorablePaneGroup DockWidth="60">
                        <avalondock:LayoutAnchorablePane>
                            <avalondock:LayoutAnchorable Title="Tools" CanClose="False" CanHide="False">
                                <StackPanel Background="{StaticResource SurfaceBrush}" Margin="4">
                                    <ui:Button Icon="{ui:SymbolIcon Cursor24}" ToolTip="Select (V)" Margin="4"/>
                                    <ui:Button Icon="{ui:SymbolIcon PenOff20}" ToolTip="Pen Tool (P)" Margin="4"/>
                                    <ui:Button Icon="{ui:SymbolIcon RectangleLandscape24}" ToolTip="Rectangle (R)" Margin="4"/>
                                    <ui:Button Icon="{ui:SymbolIcon Circle24}" ToolTip="Ellipse (E)" Margin="4"/>
                                    <ui:Button Icon="{ui:SymbolIcon Line24}" ToolTip="Line (L)" Margin="4"/>
                                    <ui:Button Icon="{ui:SymbolIcon TextT24}" ToolTip="Text (T)" Margin="4"/>
                                </StackPanel>
                            </avalondock:LayoutAnchorable>
                        </avalondock:LayoutAnchorablePane>
                    </avalondock:LayoutAnchorablePaneGroup>
                    
                    <!-- Center: Document/Canvas -->
                    <avalondock:LayoutDocumentPaneGroup>
                        <avalondock:LayoutDocumentPane>
                            <avalondock:LayoutDocument Title="Untitled.svg" CanClose="True">
                                <!-- Canvas Area -->
                                <Grid Background="{StaticResource BaseBrush}">
                                    <TextBlock Text="Canvas Area - SkiaSharp will render here"
                                               Foreground="{StaticResource SubtextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"/>
                                </Grid>
                            </avalondock:LayoutDocument>
                        </avalondock:LayoutDocumentPane>
                    </avalondock:LayoutDocumentPaneGroup>
                    
                    <!-- Right: Properties -->
                    <avalondock:LayoutAnchorablePaneGroup DockWidth="280">
                        <avalondock:LayoutAnchorablePane>
                            <avalondock:LayoutAnchorable Title="Properties" CanClose="False">
                                <ScrollViewer Background="{StaticResource SurfaceBrush}">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- Fill -->
                                        <TextBlock Text="Fill" Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
                                        <Border Background="#313244" CornerRadius="4" Padding="8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="24" Height="24" CornerRadius="4" Background="#89B4FA"/>
                                                <TextBlock Text="#89B4FA" Foreground="{StaticResource TextBrush}" 
                                                           VerticalAlignment="Center" Margin="8,0"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Stroke -->
                                        <TextBlock Text="Stroke" Foreground="{StaticResource TextBrush}" Margin="0,12,0,4"/>
                                        <Border Background="#313244" CornerRadius="4" Padding="8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="24" Height="24" CornerRadius="4" Background="Transparent"
                                                        BorderBrush="#CDD6F4" BorderThickness="2"/>
                                                <TextBlock Text="None" Foreground="{StaticResource SubtextBrush}" 
                                                           VerticalAlignment="Center" Margin="8,0"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <TextBlock Text="TRANSFORM" FontSize="11" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource SubtextBrush}" Margin="0,20,0,8"/>
                                        
                                        <!-- Position -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="X" Foreground="{StaticResource SubtextBrush}" FontSize="10"/>
                                                <ui:TextBox Text="0" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Y" Foreground="{StaticResource SubtextBrush}" FontSize="10"/>
                                                <ui:TextBox Text="0" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- Size -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="W" Foreground="{StaticResource SubtextBrush}" FontSize="10"/>
                                                <ui:TextBox Text="100" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="H" Foreground="{StaticResource SubtextBrush}" FontSize="10"/>
                                                <ui:TextBox Text="100" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </avalondock:LayoutAnchorable>
                            
                            <avalondock:LayoutAnchorable Title="Layers" CanClose="False">
                                <Grid Background="{StaticResource SurfaceBrush}">
                                    <TextBlock Text="Layers panel"
                                               Foreground="{StaticResource SubtextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </avalondock:LayoutAnchorable>
                        </avalondock:LayoutAnchorablePane>
                    </avalondock:LayoutAnchorablePaneGroup>
                    
                </avalondock:LayoutPanel>
            </avalondock:LayoutRoot>
        </avalondock:DockingManager>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="12,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ready" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="100%" Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="0 x 0" Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
