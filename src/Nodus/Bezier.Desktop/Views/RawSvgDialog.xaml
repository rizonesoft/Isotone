<ui:FluentWindow x:Class="Bezier.Desktop.Views.RawSvgDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Raw SVG Output" 
        Height="500" Width="700"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="BaseBrush" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="MantleBrush" Color="#181825"/>
        <SolidColorBrush x:Key="CrustBrush" Color="#11111B"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="#313244"/>
        <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="OverlayBrush" Color="#6C7086"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B35"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#A6E3A1"/>
        
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    
    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="📄 Raw SVG Output" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="2" Click="Close_Click" 
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Close">
                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource OverlayBrush}"/>
                </Button>
            </Grid>
        </Border>
        
        <!-- SVG Content -->
        <Border Grid.Row="1" Background="{StaticResource CrustBrush}" Margin="8">
            <TextBox x:Name="SvgTextBox" 
                     Background="Transparent"
                     Foreground="{StaticResource TextBrush}"
                     BorderThickness="0"
                     FontFamily="Cascadia Code,Consolas,Courier New"
                     FontSize="12"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="12"/>
        </Border>
        
        <!-- Actions -->
        <Border Grid.Row="2" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8">
                <Button Content="📋 Copy to Clipboard" Click="CopyToClipboard_Click" 
                        Style="{StaticResource PillButton}" Margin="0,0,8,0"/>
                <Button Content="💾 Save to File..." Click="SaveToFile_Click" 
                        Style="{StaticResource PillButton}" Margin="0,0,8,0"/>
                <Button Content="Close" Click="Close_Click" Style="{StaticResource PillButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>



