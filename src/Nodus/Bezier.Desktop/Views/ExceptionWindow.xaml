<Window x:Class="Bezier.Desktop.Views.ExceptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bezier - Exception" 
        Height="450" Width="650"
        MinHeight="300" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E2E">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BaseBrush" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="MantleBrush" Color="#181825"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="#313244"/>
        <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="RedBrush" Color="#F38BA8"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B35"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <Border Width="40" Height="40" CornerRadius="2" Margin="0,0,12,0">
                    <Border.Background>
                        <SolidColorBrush x:Name="IconBackground" Color="#F38BA8"/>
                    </Border.Background>
                    <TextBlock Text="!" FontSize="24" FontWeight="Bold" 
                               Foreground="#1E1E2E" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
                
                <!-- Title and Type -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Unhandled Exception" 
                               FontSize="18" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="ExceptionTypeText" Text="System.NullReferenceException" 
                               FontSize="12" Foreground="{StaticResource SubtextBrush}" 
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Message -->
        <Border Grid.Row="1" Background="{StaticResource Surface0Brush}" Padding="16,12">
            <TextBlock x:Name="MessageText" 
                       Text="Object reference not set to an instance of an object."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13"/>
        </Border>
        
        <!-- Stack Trace -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Stack Trace:" 
                       Foreground="{StaticResource SubtextBrush}"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            
            <Border Grid.Row="1" Background="{StaticResource MantleBrush}" 
                    CornerRadius="2" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="StackTraceText"
                             Text="   at Bezier.Desktop.Views.DebugWindow..."
                             Background="Transparent"
                             Foreground="{StaticResource SubtextBrush}"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Code,Consolas"
                             FontSize="11"
                             AcceptsReturn="True"/>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Buttons -->
        <Border Grid.Row="3" Background="{StaticResource MantleBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Copy Button -->
                <Button x:Name="CopyButton" Content="Copy to Clipboard" 
                        Click="Copy_Click"
                        Padding="16,8"
                        Background="{StaticResource Surface0Brush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderThickness="0"
                        Cursor="Hand"/>
                
                <!-- Continue Button -->
                <Button x:Name="ContinueButton" Grid.Column="2" Content="Continue" 
                        Click="Continue_Click"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Background="{StaticResource Surface0Brush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderThickness="0"
                        Cursor="Hand"/>
                
                <!-- Exit Button -->
                <Button x:Name="ExitButton" Grid.Column="3" Content="Exit Application" 
                        Click="Exit_Click"
                        Padding="16,8"
                        Background="{StaticResource RedBrush}"
                        Foreground="#1E1E2E"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
