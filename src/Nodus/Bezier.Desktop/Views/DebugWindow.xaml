<ui:FluentWindow x:Class="Bezier.Desktop.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:fi="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Developer Tools - Bezier" 
        Height="500" Width="700"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    
    <ui:FluentWindow.Resources>
        <!-- Catppuccin Mocha Colors -->
        <Color x:Key="Base">#1E1E2E</Color>
        <Color x:Key="Mantle">#181825</Color>
        <Color x:Key="Crust">#11111B</Color>
        <Color x:Key="Surface0">#313244</Color>
        <Color x:Key="Surface1">#45475A</Color>
        <Color x:Key="Surface2">#585B70</Color>
        <Color x:Key="Text">#CDD6F4</Color>
        <Color x:Key="Subtext0">#A6ADC8</Color>
        <Color x:Key="AccentOrange">#FF6B35</Color>
        <Color x:Key="Green">#A6E3A1</Color>
        <Color x:Key="Blue">#89B4FA</Color>
        <Color x:Key="Yellow">#F9E2AF</Color>
        <Color x:Key="Red">#F38BA8</Color>
        
        <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource Base}"/>
        <SolidColorBrush x:Key="MantleBrush" Color="{StaticResource Mantle}"/>
        <SolidColorBrush x:Key="CrustBrush" Color="{StaticResource Crust}"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}"/>
        <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="{StaticResource Subtext0}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentOrange}"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}"/>
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource Blue}"/>
        <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource Yellow}"/>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}"/>
    </ui:FluentWindow.Resources>
    
    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Tab Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <RadioButton x:Name="ConsoleTab" Content="Console" IsChecked="True" 
                                 Style="{StaticResource {x:Type RadioButton}}"
                                 Foreground="{StaticResource TextBrush}"
                                 Margin="0,0,8,0"/>
                    <RadioButton x:Name="CoordinatesTab" Content="Coordinates" 
                                 Style="{StaticResource {x:Type RadioButton}}"
                                 Foreground="{StaticResource TextBrush}"
                                 Margin="0,0,8,0"/>
                    <RadioButton x:Name="ElementsTab" Content="Elements" 
                                 Style="{StaticResource {x:Type RadioButton}}"
                                 Foreground="{StaticResource TextBrush}"
                                 Margin="0,0,8,0"/>
                    <RadioButton x:Name="PerformanceTab" Content="Performance" 
                                 Style="{StaticResource {x:Type RadioButton}}"
                                 Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                
                <!-- Options -->
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <CheckBox x:Name="AlwaysOnTopCheckBox" 
                              Content="Always on Top" 
                              Foreground="{StaticResource SubtextBrush}"
                              Checked="AlwaysOnTop_Changed"
                              Unchecked="AlwaysOnTop_Changed"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <Button x:Name="ClearButton" Content="Clear" 
                            Click="Clear_Click"
                            Padding="12,4"
                            Background="{StaticResource Surface0Brush}"
                            Foreground="{StaticResource TextBrush}"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Console Panel -->
            <Grid x:Name="ConsolePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Filter Bar -->
                <Border Grid.Row="0" Background="{StaticResource Surface0Brush}" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ui:TextBox x:Name="FilterTextBox" 
                                    PlaceholderText="Filter logs..."
                                    Background="{StaticResource MantleBrush}"
                                    Foreground="{StaticResource TextBrush}"
                                    BorderThickness="0"
                                    Padding="8,6"
                                    TextChanged="Filter_TextChanged"/>
                        
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="8,0,0,0">
                            <CheckBox x:Name="ShowDebugCheckBox" Content="Debug" IsChecked="True"
                                      Foreground="{StaticResource SubtextBrush}"
                                      Checked="LogLevel_Changed" Unchecked="LogLevel_Changed"
                                      Margin="0,0,8,0"/>
                            <CheckBox x:Name="ShowInfoCheckBox" Content="Info" IsChecked="True"
                                      Foreground="{StaticResource BlueBrush}"
                                      Checked="LogLevel_Changed" Unchecked="LogLevel_Changed"
                                      Margin="0,0,8,0"/>
                            <CheckBox x:Name="ShowWarningCheckBox" Content="Warning" IsChecked="True"
                                      Foreground="{StaticResource YellowBrush}"
                                      Checked="LogLevel_Changed" Unchecked="LogLevel_Changed"
                                      Margin="0,0,8,0"/>
                            <CheckBox x:Name="ShowErrorCheckBox" Content="Error" IsChecked="True"
                                      Foreground="{StaticResource RedBrush}"
                                      Checked="LogLevel_Changed" Unchecked="LogLevel_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Log List -->
                <ListBox x:Name="LogListBox" Grid.Row="1"
                         Background="{StaticResource CrustBrush}"
                         BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" 
                                           Foreground="{StaticResource SubtextBrush}"
                                           FontFamily="Cascadia Code,Consolas"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Level}" 
                                           FontFamily="Cascadia Code,Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Category}" 
                                           Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Cascadia Code,Consolas"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{Binding Message}" 
                                           Foreground="{StaticResource TextBrush}"
                                           FontFamily="Cascadia Code,Consolas"
                                           FontSize="12"
                                           TextWrapping="NoWrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Selected" Click="CopySelected_Click"/>
                            <MenuItem Header="Copy All" Click="CopyAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Export to File..." Click="ExportToFile_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
            
            <!-- Coordinates Panel (placeholder) -->
            <Grid x:Name="CoordinatesPanel" Visibility="Collapsed" Background="{StaticResource CrustBrush}">
                <TextBlock Text="Coordinates panel - Coming soon" 
                           Foreground="{StaticResource SubtextBrush}"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
            
            <!-- Elements Panel (placeholder) -->
            <Grid x:Name="ElementsPanel" Visibility="Collapsed" Background="{StaticResource CrustBrush}">
                <TextBlock Text="Elements inspector - Coming soon" 
                           Foreground="{StaticResource SubtextBrush}"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
            
            <!-- Performance Panel (placeholder) -->
            <Grid x:Name="PerformancePanel" Visibility="Collapsed" Background="{StaticResource CrustBrush}">
                <TextBlock Text="Performance metrics - Coming soon" 
                           Foreground="{StaticResource SubtextBrush}"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource MantleBrush}" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" 
                           Text="Ready" 
                           Foreground="{StaticResource SubtextBrush}"
                           FontSize="11"/>
                
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <CheckBox x:Name="AutoScrollCheckBox" 
                              Content="Auto-scroll" 
                              IsChecked="True"
                              Foreground="{StaticResource SubtextBrush}"
                              FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
