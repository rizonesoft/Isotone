<ui:FluentWindow x:Class="Bezier.Desktop.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Developer Tools" 
        Height="400" Width="600"
        MinHeight="250" MinWidth="350"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="BaseBrush" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="MantleBrush" Color="#181825"/>
        <SolidColorBrush x:Key="CrustBrush" Color="#11111B"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="#313244"/>
        <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B35"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#89B4FA"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="RedBrush" Color="#F38BA8"/>
    </ui:FluentWindow.Resources>
    
    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar (Draggable) -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Developer Tools" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource SubtextBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                    <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Pin" FontSize="10"
                              Foreground="{StaticResource SubtextBrush}"
                              Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="✕" Click="Close_Click" FontSize="10"
                            Width="20" Height="20" Padding="0"
                            Background="Transparent" Foreground="{StaticResource SubtextBrush}"
                            BorderThickness="0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- TabControl -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" 
                    Background="{StaticResource BaseBrush}"
                    BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            
            <!-- Console Tab -->
            <TabItem Header="Console">
                <Grid Background="{StaticResource CrustBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Background="{StaticResource Surface0Brush}" Padding="4,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="FilterTextBox" FontSize="10"
                                     Background="{StaticResource MantleBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0" Padding="4,2"
                                     TextChanged="Filter_TextChanged"/>
                            
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="4,0,0,0">
                                <CheckBox x:Name="ShowDebugCheckBox" Content="D" IsChecked="True" FontSize="9"
                                          Foreground="{StaticResource SubtextBrush}" ToolTip="Debug"
                                          Checked="LogLevel_Changed" Unchecked="LogLevel_Changed" Margin="0,0,2,0"/>
                                <CheckBox x:Name="ShowInfoCheckBox" Content="I" IsChecked="True" FontSize="9"
                                          Foreground="{StaticResource BlueBrush}" ToolTip="Info"
                                          Checked="LogLevel_Changed" Unchecked="LogLevel_Changed" Margin="0,0,2,0"/>
                                <CheckBox x:Name="ShowWarningCheckBox" Content="W" IsChecked="True" FontSize="9"
                                          Foreground="{StaticResource YellowBrush}" ToolTip="Warning"
                                          Checked="LogLevel_Changed" Unchecked="LogLevel_Changed" Margin="0,0,2,0"/>
                                <CheckBox x:Name="ShowErrorCheckBox" Content="E" IsChecked="True" FontSize="9"
                                          Foreground="{StaticResource RedBrush}" ToolTip="Error"
                                          Checked="LogLevel_Changed" Unchecked="LogLevel_Changed" Margin="0,0,4,0"/>
                                <Button Content="Clear" Click="Clear_Click" FontSize="9"
                                        Padding="6,1" Background="{StaticResource MantleBrush}"
                                        Foreground="{StaticResource SubtextBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Log List -->
                    <ListBox x:Name="LogListBox" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             SelectionMode="Extended" FontSize="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" 
                                               Foreground="{StaticResource SubtextBrush}"
                                               FontFamily="Consolas" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" 
                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Category}" 
                                               Foreground="{StaticResource AccentBrush}"
                                               FontFamily="Consolas" FontSize="10"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" 
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="Consolas" FontSize="10" TextWrapping="NoWrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy Selected" Click="CopySelected_Click"/>
                                <MenuItem Header="Copy All" Click="CopyAll_Click"/>
                                <Separator/>
                                <MenuItem Header="Export..." Click="ExportToFile_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </TabItem>
            
            <!-- Coordinates Tab -->
            <TabItem Header="Coords">
                <Grid Background="{StaticResource CrustBrush}">
                    <TextBlock Text="Coordinates - Coming soon" FontSize="10"
                               Foreground="{StaticResource SubtextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <!-- Elements Tab -->
            <TabItem Header="Elements">
                <Grid Background="{StaticResource CrustBrush}">
                    <TextBlock Text="Elements - Coming soon" FontSize="10"
                               Foreground="{StaticResource SubtextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <!-- Performance Tab -->
            <TabItem Header="Perf">
                <Grid Background="{StaticResource CrustBrush}">
                    <TextBlock Text="Performance - Coming soon" FontSize="10"
                               Foreground="{StaticResource SubtextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource MantleBrush}" Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="9"
                           Foreground="{StaticResource SubtextBrush}"/>
                
                <CheckBox x:Name="AutoScrollCheckBox" Grid.Column="1"
                          Content="Auto-scroll" IsChecked="True" FontSize="9"
                          Foreground="{StaticResource SubtextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
