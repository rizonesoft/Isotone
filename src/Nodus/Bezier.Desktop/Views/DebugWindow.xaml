<ui:FluentWindow x:Class="Bezier.Desktop.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Developer Tools" 
        Height="450" Width="700"
        MinHeight="300" MinWidth="450"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    
    <ui:FluentWindow.Resources>
        <!-- Catppuccin Mocha Theme -->
        <SolidColorBrush x:Key="BaseBrush" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="MantleBrush" Color="#181825"/>
        <SolidColorBrush x:Key="CrustBrush" Color="#11111B"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="#313244"/>
        <SolidColorBrush x:Key="Surface1Brush" Color="#45475A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="OverlayBrush" Color="#6C7086"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B35"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#89B4FA"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="RedBrush" Color="#F38BA8"/>
        <SolidColorBrush x:Key="PinkBrush" Color="#F5C2E7"/>
        <SolidColorBrush x:Key="MauveBrush" Color="#CBA6F7"/>
        
        <!-- Modern CheckBox Style -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="root" Background="Transparent" Padding="6,4" CornerRadius="2">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="box" Width="14" Height="14" CornerRadius="2"
                                        Background="{StaticResource Surface0Brush}"
                                        BorderBrush="{StaticResource OverlayBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="check" Text="✓" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="check" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource Surface0Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Pill Button Style -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    
    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar (Draggable) -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- App Icon -->
                <TextBlock Text="⚡" FontSize="16" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                
                <TextBlock Grid.Column="1" Text="Developer Tools" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                
                <!-- Window Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="AlwaysOnTopCheckBox" ToolTip="Pin on top"
                                  Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed"
                                  Width="28" Height="28" Background="Transparent" BorderThickness="0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="2">
                                                <TextBlock x:Name="icon" Text="📌" FontSize="12" Opacity="0.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="icon" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button Click="Close_Click" Style="{StaticResource IconButton}" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Tab Strip -->
            <Border Grid.Row="0" Background="{StaticResource MantleBrush}">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Stretch">
                    <RadioButton x:Name="ConsoleTabBtn" Content="Console" IsChecked="True"
                                 GroupName="Tabs" Checked="Tab_Checked" Tag="Console">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="{StaticResource OverlayBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Padding="12,0" Background="Transparent"
                                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="CoordsTabBtn" Content="Coordinates"
                                 GroupName="Tabs" Checked="Tab_Checked" Tag="Coordinates">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="{StaticResource OverlayBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Padding="12,0" Background="Transparent"
                                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="ElementsTabBtn" Content="Elements"
                                 GroupName="Tabs" Checked="Tab_Checked" Tag="Elements">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="{StaticResource OverlayBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Padding="12,0" Background="Transparent"
                                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="PerfTabBtn" Content="Performance"
                                 GroupName="Tabs" Checked="Tab_Checked" Tag="Performance">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="{StaticResource OverlayBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Padding="12,0" Background="Transparent"
                                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Border>
            
            <!-- Tab Content -->
            <Grid Grid.Row="1">
                <!-- Console Panel -->
                <Grid x:Name="ConsolePanel" Background="{StaticResource CrustBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Background="{StaticResource BaseBrush}" 
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Search Box -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="2" 
                                    Padding="8,4" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource OverlayBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="FilterTextBox" Grid.Column="1"
                                             Background="Transparent" Foreground="{StaticResource TextBrush}"
                                             BorderThickness="0" FontSize="11" VerticalAlignment="Center"
                                             TextChanged="Filter_TextChanged"/>
                                </Grid>
                            </Border>
                            
                            <!-- Category Filter -->
                            <Border Grid.Column="1" Background="{StaticResource Surface0Brush}" CornerRadius="2" 
                                    Padding="0" Margin="8,0,0,0" VerticalAlignment="Center">
                                <ComboBox x:Name="CategoryFilterComboBox" 
                                          Background="Transparent" BorderThickness="0"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="11" MinWidth="100" Padding="8,4"
                                          SelectionChanged="CategoryFilter_SelectionChanged">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBoxItem Content="All Categories" IsSelected="True" Tag=""/>
                                </ComboBox>
                            </Border>
                            
                            <!-- Level Filters -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <CheckBox x:Name="ShowDebugCheckBox" Content="Debug" IsChecked="True"
                                          Style="{StaticResource ModernCheckBox}" Foreground="{StaticResource OverlayBrush}"
                                          Checked="LogLevel_Changed" Unchecked="LogLevel_Changed"/>
                                <CheckBox x:Name="ShowInfoCheckBox" Content="Info" IsChecked="True"
                                          Style="{StaticResource ModernCheckBox}" Foreground="{StaticResource BlueBrush}"
                                          Checked="LogLevel_Changed" Unchecked="LogLevel_Changed"/>
                                <CheckBox x:Name="ShowWarningCheckBox" Content="Warn" IsChecked="True"
                                          Style="{StaticResource ModernCheckBox}" Foreground="{StaticResource YellowBrush}"
                                          Checked="LogLevel_Changed" Unchecked="LogLevel_Changed"/>
                                <CheckBox x:Name="ShowErrorCheckBox" Content="Error" IsChecked="True"
                                          Style="{StaticResource ModernCheckBox}" Foreground="{StaticResource RedBrush}"
                                          Checked="LogLevel_Changed" Unchecked="LogLevel_Changed"/>
                            </StackPanel>
                            
                            <!-- Actions -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📋 Copy All" Click="CopyAll_Click" Style="{StaticResource PillButton}" Margin="0,0,4,0"/>
                                <Button Content="🗑 Clear" Click="Clear_Click" Style="{StaticResource PillButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Log List -->
                    <ListBox x:Name="LogListBox" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             SelectionMode="Extended">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" 
                                               Foreground="{StaticResource OverlayBrush}"
                                               FontFamily="Cascadia Code,Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" 
                                               Foreground="{Binding LevelBrush}"
                                               FontFamily="Cascadia Code,Consolas" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Category}" 
                                               Foreground="{StaticResource AccentBrush}"
                                               FontFamily="Cascadia Code,Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" 
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="Cascadia Code,Consolas" FontSize="12" TextWrapping="NoWrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource Surface0Brush}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A313244"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy Selected" Click="CopySelected_Click"/>
                                <MenuItem Header="Copy All" Click="CopyAll_Click"/>
                                <Separator/>
                                <MenuItem Header="Export to File..." Click="ExportToFile_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
                
                <!-- Coordinates Panel -->
                <Grid x:Name="CoordinatesPanel" Visibility="Collapsed" Background="{StaticResource CrustBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource BaseBrush}" 
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <CheckBox x:Name="LiveUpdateCheckBox" Content="Live Update" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}" Foreground="{StaticResource GreenBrush}"
                                      Checked="LiveUpdate_Changed" Unchecked="LiveUpdate_Changed"/>
                            
                            <Button Grid.Column="1" Content="📋 Copy All" Click="CopyCoordinatesInfo_Click" 
                                    Style="{StaticResource PillButton}"/>
                        </Grid>
                    </Border>
                    
                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            
                            <!-- Mouse Coordinates Section -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="2" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🖱️ Mouse Coordinates" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Screen (WPF)" Foreground="{StaticResource OverlayBrush}" FontSize="11"/>
                                        <TextBlock x:Name="ScreenCoordsText" Grid.Column="1" Text="0, 0" 
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11"/>
                                        
                                        <TextBlock Grid.Row="1" Text="Document" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="DocumentCoordsText" Grid.Row="1" Grid.Column="1" Text="0, 0" 
                                                   Foreground="{StaticResource BlueBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Text="Artboard" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ArtboardCoordsText" Grid.Row="2" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource MauveBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Canvas State Section -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="2" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎨 Canvas State" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Zoom Level" Foreground="{StaticResource OverlayBrush}" FontSize="11"/>
                                        <TextBlock x:Name="ZoomLevelText" Grid.Column="1" Text="100%" 
                                                   Foreground="{StaticResource GreenBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11"/>
                                        
                                        <TextBlock Grid.Row="1" Text="Pan Offset" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="PanOffsetText" Grid.Row="1" Grid.Column="1" Text="0, 0" 
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Text="Viewport" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ViewportText" Grid.Row="2" Grid.Column="1" Text="800 × 600" 
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Selected Element Section -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="2" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="✨ Selected Element" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                    
                                    <Grid x:Name="NoSelectionGrid">
                                        <TextBlock Text="No selection" Foreground="{StaticResource OverlayBrush}" FontSize="11" FontStyle="Italic"/>
                                    </Grid>
                                    
                                    <Grid x:Name="SelectionInfoGrid" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Type" Foreground="{StaticResource OverlayBrush}" FontSize="11"/>
                                        <TextBlock x:Name="ElementTypeText" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11"/>
                                        
                                        <TextBlock Grid.Row="1" Text="Name" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ElementNameText" Grid.Row="1" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Text="Position" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ElementPositionText" Grid.Row="2" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource BlueBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="3" Text="Size" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ElementSizeText" Grid.Row="3" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource GreenBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="4" Text="Transform" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ElementTransformText" Grid.Row="4" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource YellowBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" 
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        
                                        <TextBlock Grid.Row="5" Text="Bounds" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ElementBoundsText" Grid.Row="5" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="6" Text="Fill" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ElementFillText" Grid.Row="6" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource PinkBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="7" Text="Stroke" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ElementStrokeText" Grid.Row="7" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource MauveBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Selection Bounds (for multi-select) -->
                            <Border x:Name="SelectionBoundsPanel" Background="{StaticResource Surface0Brush}" 
                                    CornerRadius="2" Padding="12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="📐 Selection Bounds" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Count" Foreground="{StaticResource OverlayBrush}" FontSize="11"/>
                                        <TextBlock x:Name="SelectionCountText" Grid.Column="1" Text="0" 
                                                   Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11"/>
                                        
                                        <TextBlock Grid.Row="1" Text="Position" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="SelectionPositionText" Grid.Row="1" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource BlueBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Text="Size" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="SelectionSizeText" Grid.Row="2" Grid.Column="1" Text="—" 
                                                   Foreground="{StaticResource GreenBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                
                <!-- Elements Panel -->
                <Grid x:Name="ElementsPanel" Visibility="Collapsed" Background="{StaticResource CrustBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource BaseBrush}" 
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="🎨 Document Elements" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="📋 SVG" Click="ViewRawSvg_Click" Style="{StaticResource PillButton}" 
                                        ToolTip="View raw SVG output" Margin="0,0,4,0"/>
                                <Button Content="🔄" Click="RefreshElements_Click" Style="{StaticResource PillButton}" 
                                        ToolTip="Refresh element tree"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Element Tree -->
                    <TreeView x:Name="ElementTreeView" Grid.Row="1" 
                              Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectedItemChanged="ElementTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#313244"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#CDD6F4"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#313244"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CDD6F4"/>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="IsExpanded" Value="True"/>
                                <EventSetter Event="MouseEnter" Handler="TreeItem_MouseEnter"/>
                                <EventSetter Event="MouseLeave" Handler="TreeItem_MouseLeave"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Height="24" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Element Type Icon -->
                                    <TextBlock Text="{Binding TypeIcon}" FontSize="12" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               ToolTip="{Binding TypeName}"/>
                                    
                                    <!-- Name/ID -->
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" 
                                               VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="Cascadia Code,Consolas" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                    
                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                        <!-- Visibility Toggle -->
                                        <Button Width="22" Height="22" Padding="0" Background="Transparent" 
                                                BorderThickness="0" Cursor="Hand"
                                                Click="ToggleVisibility_Click" Tag="{Binding}"
                                                ToolTip="Toggle visibility">
                                            <TextBlock Text="{Binding VisibilityIcon}" FontSize="11" 
                                                       Opacity="{Binding VisibilityOpacity}"/>
                                        </Button>
                                        
                                        <!-- Lock Toggle -->
                                        <Button Width="22" Height="22" Padding="0" Background="Transparent" 
                                                BorderThickness="0" Cursor="Hand"
                                                Click="ToggleLock_Click" Tag="{Binding}"
                                                ToolTip="Toggle lock">
                                            <TextBlock Text="{Binding LockIcon}" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    
                    <!-- No Elements Message -->
                    <TextBlock x:Name="NoElementsMessage" Grid.Row="1" 
                               Text="No elements in document" FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource OverlayBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    
                    <!-- Element Count -->
                    <Border Grid.Row="2" Background="{StaticResource MantleBrush}"
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="ElementCountText" Text="0 elements" FontSize="10" Margin="10,4"
                                   Foreground="{StaticResource OverlayBrush}"/>
                    </Border>
                </Grid>
                
                <!-- Performance Panel -->
                <Grid x:Name="PerformancePanel" Visibility="Collapsed" Background="{StaticResource CrustBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource BaseBrush}" 
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ Performance Monitor" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <Border x:Name="FpsIndicator" Background="{StaticResource GreenBrush}" 
                                        CornerRadius="2" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FpsBadgeText" Text="-- FPS" FontSize="10" FontWeight="Bold"
                                               Foreground="#1E1E2E"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="🔄 Reset" Click="ResetPerformance_Click" Style="{StaticResource PillButton}" 
                                        ToolTip="Reset performance metrics" Margin="0,0,4,0"/>
                                <Button Content="📋 Copy" Click="CopyPerformanceInfo_Click" Style="{StaticResource PillButton}" 
                                        ToolTip="Copy all metrics to clipboard"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Metrics Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            
                            <!-- Frame Rate Section -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="2" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📊 Frame Rate" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Current FPS" Foreground="{StaticResource OverlayBrush}" FontSize="11"/>
                                        <TextBlock x:Name="CurrentFpsText" Grid.Column="1" Text="--" 
                                                   Foreground="{StaticResource GreenBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11"/>
                                        
                                        <TextBlock Grid.Row="1" Text="Average FPS" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="AverageFpsText" Grid.Row="1" Grid.Column="1" Text="--" 
                                                   Foreground="{StaticResource BlueBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Text="Min FPS" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="MinFpsText" Grid.Row="2" Grid.Column="1" Text="--" 
                                                   Foreground="{StaticResource YellowBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="3" Text="Max FPS" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="MaxFpsText" Grid.Row="3" Grid.Column="1" Text="--" 
                                                   Foreground="{StaticResource GreenBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="4" Text="Total Frames" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TotalFramesText" Grid.Row="4" Grid.Column="1" Text="0" 
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Render Time Section -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="2" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="⏱️ Render Time" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Last Frame" Foreground="{StaticResource OverlayBrush}" FontSize="11"/>
                                        <TextBlock x:Name="LastRenderTimeText" Grid.Column="1" Text="-- ms" 
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11"/>
                                        
                                        <TextBlock Grid.Row="1" Text="Average" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="AverageRenderTimeText" Grid.Row="1" Grid.Column="1" Text="-- ms" 
                                                   Foreground="{StaticResource BlueBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Text="Max" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="MaxRenderTimeText" Grid.Row="2" Grid.Column="1" Text="-- ms" 
                                                   Foreground="{StaticResource RedBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Memory Section -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="2" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🧠 Memory Usage" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Process" Foreground="{StaticResource OverlayBrush}" FontSize="11"/>
                                        <TextBlock x:Name="ProcessMemoryText" Grid.Column="1" Text="--" 
                                                   Foreground="{StaticResource MauveBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11"/>
                                        
                                        <TextBlock Grid.Row="1" Text="GC Managed" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="GcMemoryText" Grid.Row="1" Grid.Column="1" Text="--" 
                                                   Foreground="{StaticResource PinkBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Document Stats Section -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="2" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="📄 Document Stats" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Elements" Foreground="{StaticResource OverlayBrush}" FontSize="11"/>
                                        <TextBlock x:Name="PerfElementCountText" Grid.Column="1" Text="0" 
                                                   Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11"/>
                                        
                                        <TextBlock Grid.Row="1" Text="Undo Stack" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="UndoStackText" Grid.Row="1" Grid.Column="1" Text="0" 
                                                   Foreground="{StaticResource BlueBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Text="Redo Stack" Foreground="{StaticResource OverlayBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="RedoStackText" Grid.Row="2" Grid.Column="1" Text="0" 
                                                   Foreground="{StaticResource GreenBrush}" FontFamily="Cascadia Code,Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Status Indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="11"
                               Foreground="{StaticResource OverlayBrush}"/>
                </StackPanel>
                
                <!-- Level Counts -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="DebugCountText" Text="D:0" FontSize="10" FontFamily="Cascadia Code,Consolas"
                               Foreground="{StaticResource OverlayBrush}" Margin="0,0,8,0" ToolTip="Debug entries"/>
                    <TextBlock x:Name="InfoCountText" Text="I:0" FontSize="10" FontFamily="Cascadia Code,Consolas"
                               Foreground="{StaticResource BlueBrush}" Margin="0,0,8,0" ToolTip="Info entries"/>
                    <TextBlock x:Name="WarnCountText" Text="W:0" FontSize="10" FontFamily="Cascadia Code,Consolas"
                               Foreground="{StaticResource YellowBrush}" Margin="0,0,8,0" ToolTip="Warning entries"/>
                    <TextBlock x:Name="ErrorCountText" Text="E:0" FontSize="10" FontFamily="Cascadia Code,Consolas"
                               Foreground="{StaticResource RedBrush}" ToolTip="Error entries"/>
                </StackPanel>
                
                <!-- Auto-scroll Toggle -->
                <CheckBox x:Name="AutoScrollCheckBox" Grid.Column="3"
                          Content="Auto-scroll" IsChecked="True"
                          Style="{StaticResource ModernCheckBox}"
                          Foreground="{StaticResource OverlayBrush}"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
