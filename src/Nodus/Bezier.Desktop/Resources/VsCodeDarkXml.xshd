<?xml version="1.0" encoding="utf-8" ?>
<!-- VS Code Dark+ Theme for AvalonEdit XML -->
<SyntaxDefinition name="XML" extensions=".xml;.svg;.xsl;.xslt;.xsd;.xaml"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  
  <Color name="Comment" foreground="#6A9955" fontStyle="italic"/>
  <Color name="CData" foreground="#CE9178"/>
  <Color name="DocType" foreground="#569CD6"/>
  <Color name="XmlDeclaration" foreground="#569CD6"/>
  <Color name="XmlTag" foreground="#808080"/>
  <Color name="ElementName" foreground="#569CD6"/>
  <Color name="AttributeName" foreground="#9CDCFE"/>
  <Color name="AttributeValue" foreground="#CE9178"/>
  <Color name="Entity" foreground="#569CD6"/>
  <Color name="BrokenEntity" foreground="#F44747"/>
  <Color name="Text" foreground="#D4D4D4"/>
  
  <RuleSet>
    <Span color="Comment" multiline="true">
      <Begin>&lt;!--</Begin>
      <End>--&gt;</End>
    </Span>
    
    <Span color="CData" multiline="true">
      <Begin>&lt;!\[CDATA\[</Begin>
      <End>\]\]&gt;</End>
    </Span>
    
    <Span color="DocType" multiline="true">
      <Begin>&lt;!DOCTYPE</Begin>
      <End>&gt;</End>
    </Span>
    
    <Span color="XmlDeclaration" multiline="true">
      <Begin>&lt;\?</Begin>
      <End>\?&gt;</End>
    </Span>
    
    <Span color="XmlTag" multiline="true">
      <Begin>&lt;</Begin>
      <End>&gt;</End>
      <RuleSet>
        <Span color="AttributeValue" multiline="true">
          <Begin>"</Begin>
          <End>"|(?=&lt;)</End>
        </Span>
        <Span color="AttributeValue" multiline="true">
          <Begin>'</Begin>
          <End>'|(?=&lt;)</End>
        </Span>
        <Rule color="AttributeName">[\w\d\-\:]+(?=\s*=)</Rule>
        <Rule color="ElementName">[\w\d\-\:]+</Rule>
      </RuleSet>
    </Span>
    
    <Rule color="Entity">&amp;\w+;</Rule>
    <Rule color="BrokenEntity">&amp;\w*[^;\s]*</Rule>
  </RuleSet>
</SyntaxDefinition>
