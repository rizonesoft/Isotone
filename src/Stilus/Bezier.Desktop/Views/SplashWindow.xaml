<Window x:Class="Bezier.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Bezier"
        Height="320" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Opacity="0.9">
    
    <Grid>
        <!-- Main content area - Pure Grey Base -->
        <Border Background="#1A1A1A" CornerRadius="2" Margin="8"/>
        
        <!-- Base border - subtle gray -->
        <Border CornerRadius="2" Margin="8" BorderBrush="#353535" BorderThickness="1" 
                SnapsToDevicePixels="True" UseLayoutRounding="True"/>
        
        <!-- Orange Glow that follows border - implemented via OpacityMask -->
        <Rectangle x:Name="GlowPath"
                   Margin="8" RadiusX="12" RadiusY="12"
                   StrokeThickness="1.5"
                   StrokeDashCap="Round">
            <Rectangle.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#707070" Offset="0"/>
                    <GradientStop Color="#808080" Offset="0.5"/>
                    <GradientStop Color="#909090" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Stroke>
            <Rectangle.Effect>
                <DropShadowEffect Color="#808080" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
            </Rectangle.Effect>
            <Rectangle.OpacityMask>
                <RadialGradientBrush x:Name="GlowMask" 
                                     MappingMode="Absolute" 
                                     Center="0,0" 
                                     GradientOrigin="0,0" 
                                     RadiusX="100" RadiusY="100">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>
        
        <!-- Inner content -->
        <Border CornerRadius="2" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                
                <!-- Centered Bezier SVG Logo -->
                <svgc:SvgViewbox Grid.Row="0" 
                                 Source="pack://application:,,,/Resources/Icons/Bezier.svg" 
                                 Width="80" Height="80" 
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Center" 
                                 Margin="0,30,0,0"/>
                
                <!-- Welcome Text -->
                <TextBlock Grid.Row="1"
                           Text="Bezier" 
                           FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
                           FontSize="28" 
                           FontWeight="Light" 
                           Foreground="#CDD6F4"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
                
                <!-- Tagline -->
                <TextBlock Grid.Row="2"
                           Text="SVG Editor" 
                           FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
                           FontSize="14" 
                           Foreground="#A6ADC8"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                
                <!-- Status Text -->
                <TextBlock x:Name="StatusText" 
                           Grid.Row="3"
                           Text="Loading..."
                           FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
                           FontSize="12"
                           Foreground="#6C7086"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,16"/>
                
                <!-- Version -->
                <TextBlock Grid.Row="4"
                           Text="Version 1.0.0"
                           FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
                           FontSize="10"
                           Foreground="#353535"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
