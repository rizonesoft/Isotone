<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Mocha Base Brushes -->
    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource Base}"/>
    <SolidColorBrush x:Key="MantleBrush" Color="{StaticResource Mantle}"/>
    <SolidColorBrush x:Key="CrustBrush" Color="{StaticResource Crust}"/>
    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}"/>
    <SolidColorBrush x:Key="Overlay0Brush" Color="{StaticResource Overlay0}"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="{StaticResource Overlay1}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="SubtextBrush" Color="{StaticResource Subtext0}"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="{StaticResource Subtext1}"/>
    
    <!-- Catppuccin Accent Brushes -->
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource Blue}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource Yellow}"/>
    <SolidColorBrush x:Key="PeachBrush" Color="{StaticResource Peach}"/>
    <SolidColorBrush x:Key="MauveBrush" Color="{StaticResource Mauve}"/>
    
    <!-- Gesso Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentOrangeLight}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentOrangeDark}"/>
    
    <!-- Orange Gradient Brush -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6B35" Offset="0"/>
        <GradientStop Color="#FF8C5A" Offset="0.5"/>
        <GradientStop Color="#FFAB76" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Legacy Compatibility -->
    <SolidColorBrush x:Key="GessoPrimaryBrush" Color="{StaticResource GessoPrimaryColor}" />
    <SolidColorBrush x:Key="GessoSecondaryBrush" Color="{StaticResource GessoSecondaryColor}" />
    <SolidColorBrush x:Key="GessoAccentBrush" Color="{StaticResource GessoAccentColor}" />
    
    <!-- Canvas Brushes -->
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}" />
    <SolidColorBrush x:Key="CanvasGridBrush" Color="{StaticResource CanvasGridColor}" />
    <SolidColorBrush x:Key="CanvasSelectionBrush" Color="{StaticResource CanvasSelectionColor}" />
    
    <!-- Checkerboard Pattern for Transparency -->
    <DrawingBrush x:Key="TransparencyCheckerboardBrush" 
                  TileMode="Tile" 
                  Viewport="0,0,16,16" 
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#CCCCCC">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8" />
                            <RectangleGeometry Rect="8,8,8,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    
    <!-- Layer Brushes -->
    <SolidColorBrush x:Key="LayerSelectedBrush" Color="{StaticResource LayerSelectedColor}" />
    <SolidColorBrush x:Key="LayerHoverBrush" Color="{StaticResource LayerHoverColor}" />
    <SolidColorBrush x:Key="LayerLockedBrush" Color="{StaticResource LayerLockedColor}" />
    
    <!-- Tool Brushes -->
    <SolidColorBrush x:Key="ToolActiveBrush" Color="{StaticResource ToolActiveColor}" />
    <SolidColorBrush x:Key="ToolHoverBrush" Color="{StaticResource ToolHoverColor}" />
    
</ResourceDictionary>
