<Project>
  <!-- Gesso overlay: imports the root build configuration, then sets app identity. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <MinVerTagPrefix>gesso-v</MinVerTagPrefix>
    <Product>Gesso</Product>
    <IsotoneApp>Gesso</IsotoneApp>
  </PropertyGroup>

  <!--
    The root configuration applies in full (warnings are errors, code style
    enforced): nothing is excused. The imported code's IDE0005 and CS0618 sites
    were cleared by D00 T02 §2 (2026-10-22), and NU1701 left on 2026-09-26.
  -->
</Project>
