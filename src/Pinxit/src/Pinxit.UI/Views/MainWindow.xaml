<wpfui:FluentWindow 
    x:Class="Pinxit.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Pinxit.UI.Controls"
    xmlns:vm="clr-namespace:Pinxit.UI.ViewModels"
    mc:Ignorable="d"
    Title="Pinxit"
    Width="1400"
    Height="900"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=False}">

    <wpfui:FluentWindow.Resources>
        <!-- Catppuccin Mocha Colors (override WPF-UI) -->
        <Color x:Key="Base">#1E1E2E</Color>
        <Color x:Key="Mantle">#181825</Color>
        <Color x:Key="Crust">#11111B</Color>
        <Color x:Key="Surface0">#313244</Color>
        <Color x:Key="Surface1">#45475A</Color>
        <Color x:Key="Surface2">#585B70</Color>
        <Color x:Key="Overlay0">#6C7086</Color>
        <Color x:Key="Text">#CDD6F4</Color>
        <Color x:Key="Subtext0">#A6ADC8</Color>
        <Color x:Key="Blue">#89B4FA</Color>
        <Color x:Key="Green">#A6E3A1</Color>
        <Color x:Key="Peach">#FAB387</Color>
        <Color x:Key="Red">#F38BA8</Color>
        
        <!-- Orange Accent -->
        <Color x:Key="AccentOrange">#FF6B35</Color>
        <Color x:Key="AccentOrangeLight">#FF8C5A</Color>
        
        <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource Base}"/>
        <SolidColorBrush x:Key="MantleBrush" Color="{StaticResource Mantle}"/>
        <SolidColorBrush x:Key="CrustBrush" Color="{StaticResource Crust}"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}"/>
        <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="{StaticResource Subtext0}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentOrange}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentOrangeLight}"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}"/>
        <SolidColorBrush x:Key="Overlay0Brush" Color="{StaticResource Overlay0}"/>
        
        <!-- Orange Gradient -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B35" Offset="0"/>
            <GradientStop Color="#FF8C5A" Offset="0.5"/>
            <GradientStop Color="#FFAB76" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Override System Colors -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Base}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Surface0}"/>
        
        <!-- Active Tool Button Style (RadioButton as tool selector) -->
        <Style x:Key="ActiveToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Tools"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1AFF6B35"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF6B35" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#2AFF6B35"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Simple Tool Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource CrustBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Panel Header Style -->
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
        </Style>
    </wpfui:FluentWindow.Resources>

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="Auto" />
            <!-- Menu Bar -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <wpfui:TitleBar
            Grid.Row="0"
            Title="Pinxit"
            Icon="pack://application:,,,/Assets/pinxit-icon.png"
            ShowMaximize="True"
            ShowMinimize="True"
            CanMaximize="True">
            <wpfui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0">
                    <TextBlock 
                        Text="Pinxit" 
                        FontWeight="SemiBold"
                        FontSize="12"
                        VerticalAlignment="Center" />
                    <TextBlock 
                        Text=" - " 
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock 
                        Text="{Binding DocumentTitle, FallbackValue='Untitled'}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock 
                        Text="*"
                        Visibility="{Binding IsDocumentDirty, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </wpfui:TitleBar.Header>
        </wpfui:TitleBar>

        <!-- Menu Bar -->
        <Menu Grid.Row="1" Background="Transparent">
            <wpfui:MenuItem Header="_File">
                <wpfui:MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="DocumentAdd24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenDocumentCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="FolderOpen24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <Separator />
                <wpfui:MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveDocumentCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Save24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <wpfui:MenuItem Header="_Export..." InputGestureText="Ctrl+E" Command="{Binding ExportCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="ArrowExportLtr24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <Separator />
                <wpfui:MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Dismiss24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
            </wpfui:MenuItem>

            <wpfui:MenuItem Header="_Edit">
                <wpfui:MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="ArrowUndo24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="ArrowRedo24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <Separator />
                <wpfui:MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Cut24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Copy24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="ClipboardPaste24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <Separator />
                <wpfui:MenuItem Header="_Preferences..." Command="{Binding PreferencesCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Settings24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
            </wpfui:MenuItem>

            <wpfui:MenuItem Header="_Image">
                <wpfui:MenuItem Header="Image _Size..." Command="{Binding ImageSizeCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Resize24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="Canvas S_ize..." Command="{Binding CanvasSizeCommand}" />
                <Separator />
                <wpfui:MenuItem Header="_Rotate Canvas">
                    <wpfui:MenuItem Header="90° Clockwise" Command="{Binding RotateClockwiseCommand}" />
                    <wpfui:MenuItem Header="90° Counter-Clockwise" Command="{Binding RotateCounterClockwiseCommand}" />
                    <wpfui:MenuItem Header="180°" Command="{Binding Rotate180Command}" />
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Flip Canvas">
                    <wpfui:MenuItem Header="Flip Horizontal" Command="{Binding FlipHorizontalCommand}" />
                    <wpfui:MenuItem Header="Flip Vertical" Command="{Binding FlipVerticalCommand}" />
                </wpfui:MenuItem>
            </wpfui:MenuItem>

            <wpfui:MenuItem Header="_Layer">
                <wpfui:MenuItem Header="_New Layer" InputGestureText="Ctrl+Shift+N" Command="{Binding NewLayerCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="AddSquare24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Duplicate Layer" InputGestureText="Ctrl+J" Command="{Binding DuplicateLayerCommand}" />
                <wpfui:MenuItem Header="De_lete Layer" Command="{Binding DeleteLayerCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Delete24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <Separator />
                <wpfui:MenuItem Header="_Merge Down" InputGestureText="Ctrl+E" Command="{Binding MergeDownCommand}" />
                <wpfui:MenuItem Header="Flatten _Image" Command="{Binding FlattenImageCommand}" />
            </wpfui:MenuItem>

            <wpfui:MenuItem Header="_Filter">
                <wpfui:MenuItem Header="_Blur">
                    <wpfui:MenuItem Header="Gaussian Blur..." Command="{Binding GaussianBlurCommand}" />
                    <wpfui:MenuItem Header="Motion Blur..." Command="{Binding MotionBlurCommand}" />
                    <wpfui:MenuItem Header="Surface Blur..." Command="{Binding SurfaceBlurCommand}" />
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Sharpen">
                    <wpfui:MenuItem Header="Unsharp Mask..." Command="{Binding UnsharpMaskCommand}" />
                    <wpfui:MenuItem Header="Smart Sharpen..." Command="{Binding SmartSharpenCommand}" />
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Noise">
                    <wpfui:MenuItem Header="Add Noise..." Command="{Binding AddNoiseCommand}" />
                    <wpfui:MenuItem Header="Reduce Noise..." Command="{Binding ReduceNoiseCommand}" />
                </wpfui:MenuItem>
            </wpfui:MenuItem>

            <wpfui:MenuItem Header="_View">
                <wpfui:MenuItem Header="_Zoom In" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="ZoomIn24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="ZoomOut24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Fit to Window" InputGestureText="Ctrl+0" Command="{Binding FitToWindowCommand}" />
                <wpfui:MenuItem Header="_Actual Size" InputGestureText="Ctrl+1" Command="{Binding ActualSizeCommand}" />
                <Separator />
                <wpfui:MenuItem Header="Show _Rulers" IsCheckable="True" IsChecked="{Binding ShowRulers}" />
                <wpfui:MenuItem Header="Show _Grid" IsCheckable="True" IsChecked="{Binding ShowGrid}" />
                <wpfui:MenuItem Header="Show G_uides" IsCheckable="True" IsChecked="{Binding ShowGuides}" />
            </wpfui:MenuItem>

            <wpfui:MenuItem Header="_Window">
                <wpfui:MenuItem Header="_Layers" IsCheckable="True" IsChecked="{Binding ShowLayersPanel}" />
                <wpfui:MenuItem Header="_Properties" IsCheckable="True" IsChecked="{Binding ShowPropertiesPanel}" />
                <wpfui:MenuItem Header="_History" IsCheckable="True" IsChecked="{Binding ShowHistoryPanel}" />
                <wpfui:MenuItem Header="_Navigator" IsCheckable="True" IsChecked="{Binding ShowNavigatorPanel}" />
                <wpfui:MenuItem Header="_Color" IsCheckable="True" IsChecked="{Binding ShowColorPanel}" />
                <Separator />
                <wpfui:MenuItem Header="Reset Workspace" Command="{Binding ResetWorkspaceCommand}" />
            </wpfui:MenuItem>

            <wpfui:MenuItem Header="_Help">
                <wpfui:MenuItem Header="_Documentation" Command="{Binding DocumentationCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Book24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
                <wpfui:MenuItem Header="_Keyboard Shortcuts" InputGestureText="Ctrl+Shift+?" Command="{Binding KeyboardShortcutsCommand}" />
                <Separator />
                <wpfui:MenuItem Header="_About Pinxit" Command="{Binding AboutCommand}">
                    <wpfui:MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Info24" />
                    </wpfui:MenuItem.Icon>
                </wpfui:MenuItem>
            </wpfui:MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="2" Background="{StaticResource MantleBrush}" Padding="4">
            <StackPanel Orientation="Horizontal">
                <wpfui:Button 
                    Icon="{wpfui:SymbolIcon DocumentAdd24}"
                    ToolTip="New Document (Ctrl+N)"
                    Command="{Binding NewDocumentCommand}"
                    Appearance="Secondary"
                    Margin="2" />
                <wpfui:Button 
                    Icon="{wpfui:SymbolIcon FolderOpen24}"
                    ToolTip="Open Document (Ctrl+O)"
                    Command="{Binding OpenDocumentCommand}"
                    Appearance="Secondary"
                    Margin="2" />
                <wpfui:Button 
                    Icon="{wpfui:SymbolIcon Save24}"
                    ToolTip="Save Document (Ctrl+S)"
                    Command="{Binding SaveDocumentCommand}"
                    Appearance="Secondary"
                    Margin="2" />
                
                <Separator Margin="8,4" />
                
                <wpfui:Button 
                    Icon="{wpfui:SymbolIcon ArrowUndo24}"
                    ToolTip="Undo (Ctrl+Z)"
                    Command="{Binding UndoCommand}"
                    Appearance="Secondary"
                    Margin="2" />
                <wpfui:Button 
                    Icon="{wpfui:SymbolIcon ArrowRedo24}"
                    ToolTip="Redo (Ctrl+Y)"
                    Command="{Binding RedoCommand}"
                    Appearance="Secondary"
                    Margin="2" />
                
                <Separator Margin="8,4" />
                
                <wpfui:Button 
                    Icon="{wpfui:SymbolIcon ZoomIn24}"
                    ToolTip="Zoom In (Ctrl++)"
                    Command="{Binding ZoomInCommand}"
                    Appearance="Secondary"
                    Margin="2" />
                <wpfui:Button 
                    Icon="{wpfui:SymbolIcon ZoomOut24}"
                    ToolTip="Zoom Out (Ctrl+-)"
                    Command="{Binding ZoomOutCommand}"
                    Appearance="Secondary"
                    Margin="2" />
                <TextBlock 
                    Text="{Binding ZoomLevel, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    MinWidth="50" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Tools Panel -->
                <ColumnDefinition Width="46" />
                <!-- Left Panel (Layers, etc.) -->
                <ColumnDefinition Width="280" />
                <!-- Canvas -->
                <ColumnDefinition Width="*" />
                <!-- Right Panel (Properties) -->
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Tools Panel -->
            <Border 
                Grid.Column="0" 
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="3">
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Move Tool (V)" IsChecked="True">
                        <controls:VectorIcon Icon="Move" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Selection Tool (M)">
                        <controls:VectorIcon Icon="Square" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Brush Tool (B)">
                        <controls:VectorIcon Icon="Brush" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Pencil Tool (P)">
                        <controls:VectorIcon Icon="Pencil" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Eraser Tool (E)">
                        <controls:VectorIcon Icon="Eraser" Size="18"/>
                    </RadioButton>
                    <Separator Margin="2,6" Background="{StaticResource Surface0Brush}"/>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Color Picker (I)">
                        <controls:VectorIcon Icon="Pipette" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Paint Bucket (G)">
                        <controls:VectorIcon Icon="Droplet" Size="18" IsFilled="True"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Text Tool (T)">
                        <controls:VectorIcon Icon="Type" Size="18"/>
                    </RadioButton>
                    <Separator Margin="2,6" Background="{StaticResource Surface0Brush}"/>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Crop Tool (C)">
                        <controls:VectorIcon Icon="Crop" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Hand Tool (H)">
                        <controls:VectorIcon Icon="Hand" Size="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ActiveToolButtonStyle}" ToolTip="Zoom Tool (Z)">
                        <controls:VectorIcon Icon="ZoomIn" Size="18"/>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Left Panel - Layers -->
            <Border 
                Grid.Column="1" 
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10" Background="{StaticResource Surface0Brush}">
                        <TextBlock Text="LAYERS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtextBrush}"/>
                    </Border>

                    <Border Grid.Row="1" Margin="8">
                        <TextBlock 
                            Text="No document open"
                            Foreground="{StaticResource SubtextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Canvas Area -->
            <Border 
                Grid.Column="2" 
                Background="{StaticResource BaseBrush}">
                <!-- Welcome Screen / Canvas will be displayed here -->
                <Grid>
                    <StackPanel 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Visibility="{Binding HasDocument, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                        <controls:VectorIcon 
                            Icon="Image" 
                            Size="64"
                            Foreground="{StaticResource SubtextBrush}"
                            Margin="0,0,0,16" />
                        <TextBlock 
                            Text="Welcome to Pinxit"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8" />
                        <TextBlock 
                            Text="Create a new document or open an existing one to get started"
                            Foreground="{StaticResource SubtextBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <wpfui:Button 
                                Content="New Document"
                                Icon="{wpfui:SymbolIcon DocumentAdd24}"
                                Appearance="Primary"
                                Command="{Binding NewDocumentCommand}"
                                Margin="4" />
                            <wpfui:Button 
                                Content="Open Document"
                                Icon="{wpfui:SymbolIcon FolderOpen24}"
                                Appearance="Secondary"
                                Command="{Binding OpenDocumentCommand}"
                                Margin="4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Panel - Properties -->
            <Border 
                Grid.Column="3" 
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10" Background="{StaticResource Surface0Brush}">
                        <TextBlock Text="PROPERTIES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtextBrush}"/>
                    </Border>

                    <Border Grid.Row="1" Margin="8">
                        <TextBlock 
                            Text="Select a layer to view properties"
                            Foreground="{StaticResource SubtextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border 
            Grid.Row="4" 
            Background="{StaticResource MantleBrush}"
            Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Text="{Binding StatusMessage, FallbackValue='Ready'}"
                    FontSize="11"
                    Foreground="{StaticResource SubtextBrush}"
                    VerticalAlignment="Center" />

                <TextBlock 
                    Grid.Column="1"
                    Text="{Binding CursorPosition, StringFormat='X: {0}', FallbackValue='X: 0, Y: 0'}"
                    FontSize="11"
                    Foreground="{StaticResource SubtextBrush}"
                    VerticalAlignment="Center"
                    Margin="16,0" />

                <TextBlock 
                    Grid.Column="2"
                    Text="{Binding DocumentSize, FallbackValue='1920 x 1080 px'}"
                    FontSize="11"
                    Foreground="{StaticResource SubtextBrush}"
                    VerticalAlignment="Center"
                    Margin="16,0" />

                <TextBlock 
                    Grid.Column="3"
                    Text="{Binding MemoryUsage, StringFormat='Memory: {0} MB'}"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Overlay0Brush}" />
            </Grid>
        </Border>

        <!-- Snackbar Host -->
        <wpfui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="3" />
        
        <!-- Content Dialog Host -->
        <ContentPresenter x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="5" />
    </Grid>

</wpfui:FluentWindow>
