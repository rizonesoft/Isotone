<Project>
  <!-- Pinxit overlay: imports the root build configuration, then sets app identity. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <MinVerTagPrefix>pinxit-v</MinVerTagPrefix>
    <Product>Pinxit</Product>
    <IsotoneApp>Pinxit</IsotoneApp>
  </PropertyGroup>

  <!--
    LEGACY DEBT (imported Pinxit code): the root configuration applies in full
    (warnings are errors, code style enforced) except for the diagnostics below,
    which stay visible as warnings. Listed in docs/dev/build.md; retire by TODO.
      IDE0005  unnecessary using directives
      CS0618   obsolete API use (WPF-UI IContentDialogService.SetDialogHost)
    NU1701 left on 2026-09-26: SkiaSharp.Views.WPF 4 on the Windows SDK TFM
    restores OpenTK 4 for .NET, not the .NET Framework OpenTK 3 packages.
  -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0005;CS0618</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
