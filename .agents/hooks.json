{
  "campaign-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python ../scripts/campaign_guard.py session-note",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ../scripts/campaign_guard.py stop-hook",
        "timeout": 60
      }
    ]
  },
  "delegation-guard": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|define_subagent|swarm|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ../scripts/panel_slots.py agent-gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
