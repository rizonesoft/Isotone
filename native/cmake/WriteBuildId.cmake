# Writes the build id header on every build (cmake -P, from the isotone_build_id target), so a commit or an edit
# changes the id without reconfiguring (D00 T05 §3, D00-T05-S1-PR8). The header is rewritten only when the id changes,
# so an unchanged id rebuilds nothing.
#
# Inputs: OUT (the header to write), SOURCE_DIR (the repository root), STAMP (native/BUILD_ID.txt).
# The id is the commit's first 12 hex digits, plus -dirty when tracked files differ from HEAD. A source archive made
# with git archive carries its commit in BUILD_ID.txt through export-subst, and that stamp wins: an archive unpacked
# inside another repository's work tree must not report that repository's commit. A checkout's BUILD_ID.txt holds
# the unexpanded placeholder, so it asks git, and only a work tree whose top is SOURCE_DIR.
set(id "")
file(READ "${STAMP}" stamped)
string(STRIP "${stamped}" stamped)
string(LENGTH "${stamped}" stamped_length)
# CMake's regular expressions have no {n} repetition, so the length is checked apart from the pattern.
if(stamped MATCHES "^[0-9a-f]+$" AND stamped_length GREATER_EQUAL 12)
  string(SUBSTRING "${stamped}" 0 12 id)
else()
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --show-toplevel
                    OUTPUT_VARIABLE top RESULT_VARIABLE top_rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(top_rc EQUAL 0)
      file(REAL_PATH "${top}" top)
      file(REAL_PATH "${SOURCE_DIR}" source)
      string(TOLOWER "${top}" top)
      string(TOLOWER "${source}" source)
    endif()
    if(top_rc EQUAL 0 AND top STREQUAL source)
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=12 HEAD
                      OUTPUT_VARIABLE head RESULT_VARIABLE head_rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(head_rc EQUAL 0 AND head MATCHES "^[0-9a-f]+$")
        set(id "${head}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" diff --quiet HEAD
                        RESULT_VARIABLE dirty_rc ERROR_QUIET)
        if(NOT dirty_rc EQUAL 0)
          string(APPEND id "-dirty")
        endif()
      endif()
    endif()
  endif()
endif()
if(id STREQUAL "")
  message(FATAL_ERROR "No build id: ${SOURCE_DIR} is not the top of a git work tree, and ${STAMP} was not stamped "
                      "by git archive")
endif()

set(content "// Generated by native/cmake/WriteBuildId.cmake on every build. Do not edit.\n#pragma once\n#define ISOTONE_BUILD_ID \"${id}\"\n")
set(current "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" current)
endif()
if(NOT current STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
