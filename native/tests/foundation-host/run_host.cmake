# Runs foundation-host for one CTest entry and checks what it did: the exit code, the sentence on the console, and the
# report it wrote, field by field against that exit code (D01 T15 §1).
#
#   cmake -DHOST=<foundation-host.exe> -DWORK=<empty folder for this entry> -DCASE=<name> -P run_host.cmake
#
# CASE is smoke, lifecycle, unknown-scenario, unwritable-report, missing-data-root, or window-failure. The script
# exits 77 when the host reported that there is no display session, which CTest reads as skipped.
cmake_minimum_required(VERSION 4.3)

foreach(required HOST WORK CASE)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "run_host.cmake: -D${required}=... is required")
  endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(report "${WORK}/report.json")
set(data "${WORK}/data")
set(expect_exit 0)
set(expect_result "pass")
set(expect_console "")
set(expect_report TRUE)

if(CASE STREQUAL "smoke")
  set(arguments --scenario smoke --data-root "${data}" --report "${report}")
elseif(CASE STREQUAL "lifecycle")
  set(arguments --scenario lifecycle --data-root "${data}" --report "${report}")
elseif(CASE STREQUAL "unknown-scenario")
  set(arguments --scenario no-such-scenario --data-root "${data}" --report "${report}")
  set(expect_exit 2)
  set(expect_console "unknown scenario \"no-such-scenario\"")
  set(expect_report FALSE)
elseif(CASE STREQUAL "unwritable-report")
  # A file where the report's folder should be: the folder cannot be made, so the report cannot be written.
  file(WRITE "${WORK}/blocker" "not a folder")
  set(report "${WORK}/blocker/report.json")
  set(arguments --scenario smoke --data-root "${data}" --report "${report}")
  set(expect_exit 2)
  set(expect_console "the report could not be written")
  set(expect_report FALSE)
elseif(CASE STREQUAL "missing-data-root")
  set(arguments --scenario smoke --report "${report}")
  set(expect_exit 2)
  set(expect_console "--data-root <folder> is required")
  set(expect_report FALSE)
elseif(CASE STREQUAL "window-failure")
  set(arguments --scenario smoke --fail-window --data-root "${data}" --report "${report}")
  set(expect_exit 1)
  set(expect_result "fail")
  set(expect_console "CreateWindowExW failed")
else()
  message(FATAL_ERROR "run_host.cmake: unknown CASE ${CASE}")
endif()

execute_process(COMMAND "${HOST}" ${arguments}
                RESULT_VARIABLE exit_code OUTPUT_VARIABLE console_out ERROR_VARIABLE console_err TIMEOUT 120)
message(STATUS "foundation-host ${CASE}: exit ${exit_code}")
if(console_err)
  message(STATUS "console: ${console_err}")
endif()

# No display session: the host says so in its report and by its exit code, and the entry is skipped, not passed.
if(exit_code EQUAL 77)
  if(NOT EXISTS "${report}")
    message(FATAL_ERROR "exit 77 (no display) without a report")
  endif()
  file(READ "${report}" json)
  string(JSON result GET "${json}" result)
  if(NOT result STREQUAL "no-display")
    message(FATAL_ERROR "exit 77 with result \"${result}\", not \"no-display\"")
  endif()
  message(STATUS "skipped: no display session")
  cmake_language(EXIT 77)
endif()

if(NOT exit_code EQUAL expect_exit)
  message(FATAL_ERROR "exit code ${exit_code}, expected ${expect_exit}\n${console_out}\n${console_err}")
endif()
if(expect_console)
  string(FIND "${console_err}" "${expect_console}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "the console does not say \"${expect_console}\":\n${console_err}")
  endif()
endif()
if(CASE STREQUAL "missing-data-root" AND EXISTS "${data}")
  message(FATAL_ERROR "a run refused for its missing --data-root still wrote under ${data}")
endif()

if(NOT expect_report)
  if(EXISTS "${report}")
    message(FATAL_ERROR "a refused run wrote a report at ${report}")
  endif()
  return()
endif()

# The report: every field of the schema, consistent with the exit code.
if(NOT EXISTS "${report}")
  message(FATAL_ERROR "no report at ${report}")
endif()
file(READ "${report}" json)
string(JSON schema_version GET "${json}" schema_version)
string(JSON scenario GET "${json}" scenario)
string(JSON result GET "${json}" result)
string(JSON failure_count LENGTH "${json}" failures)
string(JSON build_id GET "${json}" build_id)
string(JSON measurements_type TYPE "${json}" measurements)
if(NOT schema_version EQUAL 1)
  message(FATAL_ERROR "schema_version is ${schema_version}, expected 1")
endif()
list(GET arguments 1 asked_scenario)
if(NOT scenario STREQUAL asked_scenario)
  message(FATAL_ERROR "the report is for scenario \"${scenario}\", not \"${asked_scenario}\"")
endif()
if(NOT result STREQUAL expect_result)
  message(FATAL_ERROR "result is \"${result}\", expected \"${expect_result}\"\n${json}")
endif()
if(result STREQUAL "pass" AND NOT failure_count EQUAL 0)
  message(FATAL_ERROR "a passing report lists ${failure_count} failure(s)")
endif()
if(result STREQUAL "fail" AND failure_count EQUAL 0)
  message(FATAL_ERROR "a failing report lists no failure")
endif()
if(NOT build_id MATCHES "^[0-9a-f]+(-dirty)?$")
  message(FATAL_ERROR "build_id is \"${build_id}\"")
endif()
if(NOT measurements_type STREQUAL "OBJECT")
  message(FATAL_ERROR "measurements is ${measurements_type}, not an object")
endif()

if(CASE STREQUAL "window-failure")
  string(JSON first_failure GET "${json}" failures 0)
  if(NOT first_failure MATCHES "CreateWindowExW failed")
    message(FATAL_ERROR "the failure does not name the failing call: ${first_failure}")
  endif()
endif()

if(CASE STREQUAL "smoke")
  string(JSON dpi GET "${json}" measurements dpi)
  string(JSON awareness GET "${json}" measurements dpi_awareness)
  string(JSON width GET "${json}" measurements client_width_px)
  string(JSON height GET "${json}" measurements client_height_px)
  string(JSON menu_count LENGTH "${json}" measurements menus)
  if(dpi LESS 96 OR width LESS 1 OR height LESS 1)
    message(FATAL_ERROR "dpi ${dpi}, client ${width} x ${height}")
  endif()
  if(NOT awareness STREQUAL "per-monitor-v2")
    message(FATAL_ERROR "dpi_awareness is \"${awareness}\"")
  endif()
  if(NOT menu_count EQUAL 4)
    message(FATAL_ERROR "${menu_count} menus, expected 4")
  endif()
  set(command_total 0)
  foreach(index RANGE 3)
    string(JSON command_count LENGTH "${json}" measurements menus ${index} commands)
    math(EXPR command_total "${command_total} + ${command_count}")
  endforeach()
  if(NOT command_total EQUAL 8)
    message(FATAL_ERROR "${command_total} commands, expected 8")
  endif()
  foreach(panel left right)
    string(JSON expected GET "${json}" measurements panels ${panel} expected)
    string(JSON painted GET "${json}" measurements panels ${panel} painted)
    if(NOT painted STREQUAL expected)
      message(FATAL_ERROR "the ${panel} panel is painted ${painted}, its token gives ${expected}")
    endif()
  endforeach()
  # The host kept its log and its settings under the data root, through isotone::core.
  file(GLOB_RECURSE kept "${data}/*settings.json" "${data}/*.log")
  list(LENGTH kept kept_count)
  if(kept_count LESS 2)
    message(FATAL_ERROR "no settings file and log under ${data}: ${kept}")
  endif()
  message(STATUS "smoke: ${dpi} DPI, client ${width} x ${height} px, ${awareness}, 4 menus, 8 commands, panels painted")
endif()

if(CASE STREQUAL "lifecycle")
  string(JSON destroyed GET "${json}" measurements destroyed)
  string(JSON paints GET "${json}" measurements paints)
  string(JSON layouts GET "${json}" measurements layouts)
  if(NOT destroyed OR paints LESS 2 OR layouts LESS 2)
    message(FATAL_ERROR "destroyed ${destroyed}, paints ${paints}, layouts ${layouts}")
  endif()
  message(STATUS "lifecycle: ${paints} paints, ${layouts} layouts, destroyed")
endif()
