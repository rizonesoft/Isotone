<?xml version="1.0" encoding="utf-8"?>
<!--
  Suite-wide test settings (wired in Directory.Build.props via RunSettingsFilePath).
  The QUARANTINE, when it holds anything, is a TestCaseFilter here
  (one exclusion per test): known-failing tests excluded so the gate
  stays green. Every entry is debt tracked in docs/dev/build.md with an owner, per
  standards/testing.md ("The quarantine"); remove the entry in the same change that
  fixes the test. It has been empty since D00 T02 §1 (2026-10-22).
-->
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>../artifacts/TestResults</ResultsDirectory>
  </RunConfiguration>
</RunSettings>
