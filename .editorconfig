# EditorConfig: Isotone Graphics Suite
# https://editorconfig.org
# One file for the whole repository. C and C++ entries match native/.clang-format
# (BasedOnStyle: Microsoft, ColumnLimit: 120, 4-space indentation, LF line endings).

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Native C, C++, and CMake sources (matches native/.clang-format)
[*.{c,cc,cpp,cxx,c++,h,hh,hpp,hxx,h++,ixx,inl,ipp}]
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 120

[{CMakeLists.txt,*.cmake}]
end_of_line = lf
indent_style = space
indent_size = 4

# Windows installer and manifest sources keep CRLF (matches .gitattributes)
[*.{iss,manifest}]
end_of_line = crlf

# XML and manifest files
[*.{xml,manifest}]
indent_size = 2

# JSON, YAML, and TOML
[*.{json,yml,yaml,toml}]
indent_size = 2

# Scripts
[*.{ps1,psm1,psd1,py,sh}]
indent_size = 4

[*.sh]
indent_size = 2

# Markdown: trailing double-space is a hard line break
[*.md]
trim_trailing_whitespace = false

# Generated output
[**/artifacts/**]
generated_code = true

# HLSL Shader Files
[*.hlsl]
indent_size = 4
indent_style = space

[*.hlsli]
indent_size = 4
indent_style = space
